<?xml version="1.0" encoding="UTF-8"?>
<widget class="window" style="default" name="wnd_flexible_passwd">
    <property>
        <rect>[400,190,480,240]</rect>
        <forecolor>[gui_trans,gui_trans,gui_trans]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
    </property>
    <signal>
        <create>app_flexible_passwd_create</create>
        <destroy>app_flexible_passwd_destroy</destroy>
        <keypress>app_flexible_passwd_keypress</keypress>
    </signal>
    <children>
        <widget class="image" style="default" name="img_flexible_passwd_back">
            <property>
                <rect>[0,0,480,240]</rect>
                <forecolor>[osd_trans,osd_trans,osd_trans]</forecolor>
                <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
                <mode>multiple</mode>
                <img></img>
                <lt_img>s_win_l_t</lt_img>
                <rt_img>s_win_r_t</rt_img>
                <lb_img>s_win_l_b</lb_img>
                <rb_img>s_win_r_b</rb_img>
                <l_img>s_win_l_m</l_img>
                <r_img>s_win_r_m</r_img>
                <t_img>s_win_m_t</t_img>
                <b_img>s_win_m_b</b_img>
            </property>
        </widget>
        <widget class="text" style="default" name="text_flexible_passwd_title">
            <property>
                <rect>[15,2,450,35]</rect>
                <forecolor>[pop_title_color,pop_title_color,pop_title_color]</forecolor>
                <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
                <string>Input PIN</string>
                <format>static</format>
            </property>
        </widget>
        <widget class="edit" style="default" name="edit_flexible_passwd_input">
            <property>
                <rect>[96,80,200,30]</rect>
                <forecolor>[text_color,text_color,text_color]</forecolor>
                <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
                <default_intaglio>-</default_intaglio>
                <intaglio>*</intaglio>
                <maxlen>4</maxlen>
                <format>edit_digit</format>
            </property>
            <signal>
                <keypress>app_flexible_passwd_input_keypress</keypress>
                <change>app_flexible_passwd_input_change</change>
                <reach_end>app_flexible_passwd_input_reach_end</reach_end>
            </signal>
        </widget>
    </children>
</widget>
