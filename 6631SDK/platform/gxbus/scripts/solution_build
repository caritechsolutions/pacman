#!/bin/bash
set -e

CURRENT_PATH=$(cd `dirname $0`; pwd)
PLATFORM_PATH=${CURRENT_PATH}/../../
gxtest_path=$CURRENT_PATH/../../../gxtest

function check_buildroot_config() {
	local array

	buildroot="./buildroot/.config"
	if [[ -f $buildroot ]];then
		PROFILE=$(cat buildroot/.config | grep CONFIG_PROFILE_NAME | awk -F "=\"" '{print $2}' |  awk -F "\"" '{print $1}')
	else
		config_list=$(ls buildroot/profile)
		echo -e "\033[33;1mPlease Choose one from below for [buildroot config]\033[0m\n"
		index=0
		for p in $config_list;
		do
			S_ARCH=`cat buildroot/profile/$p/package.config | grep -w CONFIG_ARCH | awk -F "=" '{print $2}' | tr -d '"'`
			if [[ $S_ARCH == $ARCH ]]; then
				let index=index+1
				array[$index]=$p
				echo -e "\t\033[32;1m[$index] $p\033[0m"
			fi
		done
		echo -en "\n\033[33;1mInput config num (1-${#array[*]}): \033[0m"
		read -e NUM
		if [[ $NUM -gt ${#array[*]} || $NUM -le 0 ]];then
			echo -en "\n\033[31;1mInput profile num out of range!! \033[0m\n"
			exit 1
		fi
		PROFILE=${array[$NUM]}
	fi
	echo -e "Choose linux profile = \033[31;1m"buildroot/profile/"$PROFILE\033[0m"
}

function check_solution_config() {
	local array

	solution="./solution/.config"
	if [[ -f $solution ]];then
		S_OS=`cat solution/.config | grep BR2_OS_NAME | awk -F "=" '{print $2}' | tr -d '"'`
		S_CHIP=`cat solution/.config | grep BR2_CHIP_NAME | awk -F "=" '{print $2}' | tr -d '"'`

		if [[ $S_CHIP == "sirius" || $S_CHIP == "canopus" || $S_CHIP == "vega" ]]; then
			S_ARCH=arm
		else
			S_ARCH=csky
		fi

		if [[ $S_ARCH == $ARCH && $S_OS == "$OS" ]]; then
			CONFIG=`cat solution/.config | grep BR2_PROJ_NAME | awk -F "=" '{print $2}' | tr -d '"'`
			echo -e "\033[32;1mCompile solution with project $CONFIG\033[0m"
		else
			echo -e "\033[31;1mCompile solution with error defconfig\033[0m"
			rm ./solution/.config
		fi
	fi

	if [[ ! -f $solution ]];then
		config_list=$(ls solution/configs)

		index=0
		for p in $config_list;
		do
			if [[ -d solution/configs/$p ]]; then
				continue;
			fi
			S_OS=`cat solution/configs/$p | grep BR2_OS_NAME | awk -F "=" '{print $2}' | tr -d '"'`
			S_CHIP=`cat solution/configs/$p | grep BR2_CHIP_NAME | awk -F "=" '{print $2}' | tr -d '"'`
			if [[ $S_CHIP == "sirius" || $S_CHIP == "canopus" || $S_CHIP == "vega" ]]; then
				S_ARCH=arm
			else
				S_ARCH=csky
			fi
			if [[ $S_ARCH == $ARCH && $S_OS == $OS ]]; then
				if [[ ${OS} == "ecos" ]]; then
					let index=index+1
					array[$index]=$p
				else
					if [[ -f buildroot/.config ]]; then
						B_CHIP=`cat buildroot/.config | grep CONFIG_KERNEL_DEFCONFIG | awk -F '"' '{print $2}' | awk -F '_' '{print $1}'`
					else
						B_CHIP=`cat buildroot/profile/${PROFILE}/package.config | grep CONFIG_KERNEL_DEFCONFIG | awk -F '"' '{print $2}' | awk -F '_' '{print $1}'`
					fi
					if [[ ${B_CHIP} == ${S_CHIP} ]]; then
						let index=index+1
						array[$index]=$p
					fi
				fi
			fi
		done

		if [[ $index -lt 1 ]]; then
			echo -en "\n\033[33;1mDon't exist match solution config \033[0m\n"
			exit 1
		fi

		if [[ ${index} -eq 1 ]]; then
			cp solution/configs/${array[$index]} solution/.config
		else
			echo -e "\033[33;1mPlease Choose one from below for [solution config]\033[0m\n"
			for((index = 1; index <= ${#array[*]}; index++)) do
				echo -e "\t\033[32;1m[$index] ${array[$index]}\033[0m"
			done
			echo -en "\n\033[33;1mInput config num (1-${#array[*]}): \033[0m"
			read -e NUM
			if [[ $NUM -gt ${#array[*]} || $NUM -le 0 ]];then
				echo -en "\n\033[31;1mInput profile num out of range!! \033[0m\n"
				exit 1
			fi
			CONFIG=${array[$NUM]}
			cp solution/configs/$CONFIG solution/.config || exit 1
		fi
	fi

	CHIP=$(cat solution/.config | grep "^BR2_CHIP_NAME=" | sed 's/^BR2_CHIP_NAME=\"\(\S\+\)\"/\1/g')
	PROJ=$(cat solution/.config | grep "^BR2_PROJ_NAME=" | sed 's/^BR2_PROJ_NAME=\"\(\S\+\)\"/\1/g')
	FAMI=$(cat solution/.config | grep "^BR2_FAMILY_NAME=" | sed 's/^BR2_FAMILY_NAME=\"\(\S\+\)\"/\1/g')
	echo -e "\033[32;1mconfig chip = $CHIP\033[0m"
	echo -e "\033[32;1mconfig project name = $PROJ\033[0m"
	echo -e "\033[32;1mconfig family name = $FAMI\033[0m"

	if [[ "$PROFILE" == "sirius_nand" ]]; then
		echo -e "\033[32;1msupport sirius spi nand \033[0m"
		sed -i "/^# BR2_MOD_NAND_FLASH is not set/cBR2_MOD_NAND_FLASH=y" solution/.config
	else
		echo -e "\033[32;1msupport sirius nor flash \033[0m"
		sed -i "/^BR2_MOD_NAND_FLASH=y/c# BR2_MOD_NAND_FLASH is not set" solution/.config
	fi

}

function info() {
	echo -e "\n=================================================================================="
	echo -e "\e[1;32mARCH:\e[0m             $ARCH"
	echo -e "\e[1;32mOS:\e[0m               $OS"
	echo -e "\e[1;32mPREFIX:\e[0m           $GX_PREFIX"
	echo -e "\e[1;32mLIB:\e[0m              $GXLIB_PATH"
	echo -e "\e[1;32mKERNEL:\e[0m           $GX_KERNEL_PATH"
	echo -e "\e[1;32mCROSS_COMPILE:\e[0m    $CROSS_COMPILE"
	echo -e "\e[1;32mBUILDROOT:\e[0m        $PROFILE"
	#echo -e "\e[1;32mSOLUTION:\e[0m  $CONFIG"
	echo -e "==================================================================================\n"
}

function set_env() {
	GX_PREFIX=`pwd`/library/goxceed
	if [ ${OS} == "linux-tee" ]; then
		CROSS_PATH=$ARCH-linux
	elif [ ${OS} == "ecos-tee" ]; then
		CROSS_PATH=$ARCH-ecos
	else
		CROSS_PATH=$ARCH-$OS
	fi
	GXLIB_PATH=$GX_PREFIX/$CROSS_PATH
	GX_KERNEL_PATH=`pwd`/buildroot/kernel/4.9.y
	GX_APP_PATH=`pwd`/solution/projects

	if [[ -z $CROSS_COMPILE ]]; then
		if [[ "$ARCH-$OS" = "arm-linux" ]]; then
			CROSS_COMPILE=arm-linux-uclibcgnueabihf-
		elif [[ "$ARCH-$OS" = "arm-linux-tee" ]]; then
			CROSS_COMPILE=arm-linux-uclibcgnueabihf-
		elif [[ "$ARCH-$OS" = "arm-ecos" ]]; then
			CROSS_COMPILE=arm-none-eabi-
		elif [[ "$ARCH-$OS" = "arm-ecos-tee" ]]; then
			CROSS_COMPILE=arm-none-eabi-
		elif [[ "$ARCH-$OS" = "arm-nos" ]]; then
			CROSS_COMPILE=arm-none-eabi-
		elif [[ "$ARCH-$OS" = "csky-ecos" ]]; then
			CROSS_COMPILE=csky-elf-
		elif [[ "$ARCH-$OS" = "csky-nos" ]]; then
			CROSS_COMPILE=csky-elf-
		elif [[ "$ARCH-$OS" = "csky-linux" ]]; then
			CROSS_COMPILE=csky-linux-
		fi
	fi

	if [[ ! -d $GX_PREFIX ]];then
		echo -e "\033[31;1mMkdir prefix : $GX_PREFIX\033[0m"
		mkdir -p $GX_PREFIX
	fi

	export GX_PREFIX GXLIB_PATH GX_KERNEL_PATH ARCH OS CROSS_PATH CROSS_COMPILE

	if [[ "$OS" == "linux" || "$OS" == "linux-tee" ]]; then
		check_buildroot_config
	fi
	if [ "$1" == 'solution' ]; then
		check_solution_config
	fi
	info
}

function build_ecos3.0() {
	echo -e "\033[31;1mStart build ecos3.0\033[0m"
	cd ./platform/ecos3.0

	if [[ ${ARCH} == "arm" ]]; then
		ARCH_TMP=arm_smp
	else
		ARCH_TMP=${ARCH}
	fi

	if [[ "$OPTIMIZE" == "memory" ]]; then
		loglevel=0 optimize=Os ./build $ARCH_TMP $OS || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=0 optimize=Os ./build $ARCH_TMP $OS"; exit 1; }
	else
		# 没有配置全局编译选项并且编译选项配置文件存在
		if [[ -z ${loglevel} ]] && [[ -z ${optimize} ]] && [[ -s ${CURRENT_PATH}/solution_build_config ]]; then
			# 定义关联数组存储配置
			declare -A solution_build_config

			# 读取配置文件到关联数组
			while IFS='=' read -r key value; do
				[[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
				solution_build_config["$key"]="$value"
			done < "${CURRENT_PATH}/solution_build_config"

			# 提取需要的变量
			local loglevel=${solution_build_config[ecos3_0_loglevel]}
			local optimize=${solution_build_config[ecos3_0_optimize]}
		fi
		loglevel=${loglevel} optimize=${optimize} ./build $ARCH_TMP $OS || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=${loglevel} optimize=${optimize} ./build $ARCH_TMP $OS"; exit 1; }
	fi
	cd -
}

function cleanup_ecos3.0() {
	echo -e "\033[31;1mStart cleanup ecos3.0\033[0m"
	cd ./platform/ecos3.0

	./build clean || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build clean"; exit 1; }
	cd -
}

