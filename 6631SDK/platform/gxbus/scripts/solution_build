function build_gxavdev() {
	echo -e "\033[31;1mStart build gxavdev\033[0m"
	cd ./platform/gxavdev

	prj=""
	if [ $# -ge 2 ]; then
		arch=$1
		os=$2
		prj=$3
	else
		arch=${ARCH}
		os=${OS}
	fi

	if [[ $submode =~ "gxtest" ]]; then
		if [[ ${BOARD} =~ "NNE" ]]; then
			type=irdeto
		elif [[ ${BOARD} =~ "generic-NNM" ]]; then
			type=test
		elif [[ ${BOARD} =~ "fpga-NNM" ]]; then
			type=test
		elif [[ ${BOARD} =~ "NNR" ]]; then
			type=test # 暂时用 test 固件，有正式固件后改成正式固件
		elif [[ ${BOARD} =~ "NNM" ]]; then
			type=vmx
		else
			type=""
		fi
	elif [[ $submode == "solution" ]]; then
		if [[ -n `grep -w "BR2_MOD_CHIP_NNE=y" ${PLATFORM_PATH}../solution/.config` ]]; then
			type=irdeto
		elif [[ -n `grep -w "BR2_MOD_CHIP_NNM=y" ${PLATFORM_PATH}../solution/.config` ]]; then
			type=vmx
		else
			type=""
		fi
	else
		echo "unsupport submode = $submode !"
		exit 1
	fi

	if [[ "$OPTIMIZE" == "memory" ]]; then
		loglevel=0 optimize=Os fwtype=${type} ./build $arch $os $prj || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=0 optimize=Os fwtype=${type} ./build $arch $os $prj"; exit 1; }
	else
		if [[ -z ${loglevel} ]] && [[ -z ${optimize} ]] && [[ -s ${CURRENT_PATH}/solution_build_config ]]; then
			# 定义关联数组存储配置
			declare -A solution_build_config

			# 读取配置文件到关联数组
			while IFS='=' read -r key value; do
				[[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
				solution_build_config["$key"]="$value"
			done < "${CURRENT_PATH}/solution_build_config"

			# 提取需要的变量
			local loglevel=${solution_build_config[gxavdev_loglevel]}
			local optimize=${solution_build_config[gxavdev_optimize]}
		fi
		loglevel=${loglevel} optimize=${optimize} fwtype=${type} ./build $arch $os $prj || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=${loglevel} optimize=${optimize} fwtype=${type} ./build $arch $os $prj"; exit 1; }
	fi
	cd -
}

function cleanup_gxavdev() {
	echo -e "\033[31;1mStart cleanup gxavdev\033[0m"
	cd ./platform/gxavdev

	./build clean || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build clean"; exit 1; }
	cd -
}

