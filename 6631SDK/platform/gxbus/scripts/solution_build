function build_gxsecure() {
	echo -e "\033[31;1mStart build gxsecure\033[0m"
	cd ./platform/gxsecure

	if_build_firmware="no"
	if [ $# -eq 2 ]; then
		arch=$1
		os=$2
	elif [ $# -eq 3 ]; then
		if_build_firmware="yes"
	else
		arch=${ARCH}
		os=${OS}
	fi

	if [ ${if_build_firmware} == "yes" ]; then
		./build $1 $2 $3 || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build $1 $2 $3"; exit 1; }
	else
		if [[ "$OPTIMIZE" == "memory" ]]; then
			if [ "${OS}" == "linux-tee" ];then
				loglevel=0 ./build $arch $os optee || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=0 ./build $arch $os optee"; exit 1; }
			else
				loglevel=0 ./build $arch $os || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=0 ./build $arch $os"; exit 1; }
			fi
		else
			if [[ -z ${loglevel} ]] && [[ -z ${optimize} ]] && [[ -s ${CURRENT_PATH}/solution_build_config ]]; then
				# 定义关联数组存储配置
				declare -A solution_build_config

				# 读取配置文件到关联数组
				while IFS='=' read -r key value; do
					[[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
					solution_build_config["$key"]="$value"
				done < "${CURRENT_PATH}/solution_build_config"

				# 提取需要的变量
				local loglevel=${solution_build_config[gxsecure_loglevel]}
				local optimize=${solution_build_config[gxsecure_optimize]}
			fi
			if [ "${OS}" == "linux-tee" ];then
				loglevel=${loglevel} optimize=${optimize} ./build $arch $os optee || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=${loglevel} optimize=${optimize} ./build $arch $os optee"; exit 1; }
			else
				loglevel=${loglevel} optimize=${optimize} ./build $arch $os || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=${loglevel} optimize=${optimize} ./build $arch $os"; exit 1; }
			fi
		fi
	fi
	cd -
}

function cleanup_gxsecure() {
	echo -e "\033[31;1mStart cleanup gxsecure\033[0m"
	cd ./platform/gxsecure

	./build clean || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build clean"; exit 1; }
	cd -
}

function build_secure_firmware() {
	if [[ $submode =~ "gxtest-goxceed" ]]; then
		echo -e "\033[31;1mStart build secure firmware\033[0m"
		cd ./platform/gxosal
		./build csky seos || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build csky seos"; exit 1; }
		cd -
		cd ./platform/gxsecure
		TKCAS=$(sed -n 's/^[[:space:]]*TKCAS[[:space:]]*=[[:space:]]*\(.*\)/\1/p' ${gxtest_path}/stb/goxceed/cases/service/gxsecure/tfm/firmware/firmware_config | xargs)
		TCAS=$(sed -n 's/^[[:space:]]*TCAS[[:space:]]*=[[:space:]]*\(.*\)/\1/p' ${gxtest_path}/stb/goxceed/cases/service/gxsecure/tfm/firmware/firmware_config | xargs)
		if [[ $TCAS == "y" ]]; then
			./build firmware ${CHIP} TCAS || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build firmware ${CHIP} TCAS"; exit 1; }
			cp ${GXLIB_PATH}/lib/firmware/secure/*TCAS.fw ${gxtest_path}/stb/goxceed/cases/service/gxsecure/tfm/firmware/current/
		fi
		if [[ $TKCAS == "y" ]]; then
			./build firmware ${CHIP} TKCAS || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build firmware ${CHIP} TKCAS"; exit 1; }
			cp ${GXLIB_PATH}/lib/firmware/secure/*TKCAS.fw ${gxtest_path}/stb/goxceed/cases/service/gxsecure/tfm/firmware/current/
		fi
		cd -
		mkdir -p ${gxtest_path}/stb/goxceed/cases/service/gxsecure/tfm/firmware/current/
	fi
}

function build_gxosal() {
	echo -e "\033[31;1mStart build gxosal\033[0m"
	cd ./platform/gxosal

	if [ $# -eq 2 ]; then
		arch=$1
		os=$2
	else
		arch=${ARCH}
		os=${OS}
	fi

	if [[ "$OPTIMIZE" == "memory" ]]; then
		loglevel=0 optimize=Os ./build $arch $os || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=0 optimize=Os ./build $arch $os"; exit 1; }
	else
		if [[ -s ${CURRENT_PATH}/solution_build_config ]]; then
			# 定义关联数组存储配置
			declare -A solution_build_config

			# 读取配置文件到关联数组
			while IFS='=' read -r key value; do
				[[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
				solution_build_config["$key"]="$value"
			done < "${CURRENT_PATH}/solution_build_config"

			# 提取需要的变量
			local loglevel=${solution_build_config[gxosal_loglevel]}
			local optimize=${solution_build_config[gxosal_optimize]}
		fi
		loglevel=${loglevel} optimize=${optimize} ./build $arch $os || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: loglevel=${loglevel} optimize=${optimize} ./build $arch $os "; exit 1; }
	fi

	cd -
}

