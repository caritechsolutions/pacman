function build_gxlowpower() {
	echo -e "\033[31;1mStart build gxlowpower\033[0m"
	cd ./platform/gxlowpower
	case "$CHIP" in
		gx3201|gx3211|gx6605s|gx3113c)
			./build $CHIP || exit 1
			cp ./ck610/gxlowpower.fw $GX_PREFIX
			cp ./ck610/gxlowpower.fw $GX_APP_PATH/$FAMI/$PROJ/firmware
			;;
		sirius|taurus|gemini|cygnus|canopus|vega|scorpio|scorpio-taurus)
			./build $CHIP || exit 1
			cp ./xx51/gxlowpower.fw $GX_PREFIX
			cp ./xx51/gxlowpower.fw $GX_APP_PATH/$FAMI/$PROJ/firmware
			;;
		*)
			echo "EORROR CHIP_ID: $CHIP"
			solution_usage
			;;
	esac
	cd -
}

