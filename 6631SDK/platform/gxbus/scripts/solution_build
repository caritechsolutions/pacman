function build_nos_lib() {
	echo -e "\033[31;1mStart build gxloader\033[0m"
	cd ./platform/gxloader

	if [[ "${NOS_LIB_PRE}" == "yes" ]]; then
		search_dir="conf/${CHIP}/${BOARD}"
		search_str1="ENABLE_USB ="
		search_str2="ENABLE_FAT_WRITE ="

		file_array=()
		while IFS= read -r -d '' file; do
			file_array+=("${file}")
		done < <(find "${search_dir}" -type f -print0)

		for file in "${file_array[@]}"; do
			if grep -q "${search_str1}" "${file}"; then
				sed -i 's|ENABLE_USB = n|ENABLE_USB = y|' ${file}
			else
				sed -i '$aENABLE_USB = y' ${file}
			fi
			if grep -q "${search_str2}" "${file}"; then
				sed -i 's|ENABLE_FAT_WRITE = n|ENABLE_FAT_WRITE = y|' ${file}
			else
				sed -i '$aENABLE_FAT_WRITE = y' ${file}
			fi
		done
	fi

	./build $CHIP $BOARD lib || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build $CHIP $BOARD lib"; exit 1; }
	cd -
}

function cleanup_nos_lib() {
	echo -e "\033[31;1mStart cleanup gxloader\033[0m"
	cd ./platform/gxloader

	./build clean || { echo "【!!!compiled failed】【${BASH_SOURCE[0]}: $LINENO】Command: ./build clean"; exit 1; }
	cd -
}

