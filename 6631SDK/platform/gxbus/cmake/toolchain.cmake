SET(ARCH_OS $ENV{ARCH_OS})
SET(MULTIPROCESS $ENV{MULTIPROCESS})
SET(CROSS_COMPILE $ENV{CROSS_COMPILE})
SET(GX_OPTIMIZE $ENV{GX_OPTIMIZE})
SET(GX_LOGLEVEL $ENV{GX_LOGLEVEL})
SET(GX_EXT_CFLAGS $ENV{GX_EXT_CFLAGS})
SET(GX_DEBUG_EXTRA $ENV{GX_DEBUG_HOLE} $ENV{GX_DEBUG_HEAP} $ENV{GX_DEBUG_FLOW})
SET(GX_SSLLIB $ENV{GX_SSLLIB})
SET(GX_XMLLIB_VERSION $ENV{GX_XMLLIB_VERSION})

SET(CMAKE_C_COMPILER_FORCED TRUE)
SET(CMAKE_CXX_COMPILER_FORCED TRUE)

#ADD_DEFINITIONS(-D$ENV{ARCH} -D$ENV{ARCH}-$ENV{OS})
IF (ARCH_OS STREQUAL arm-ecos)
	SET(ARCH arm)
	SET(OS   ECOS)
	SET(EXTRA_CFLAGS "-Wno-cpp -Wno-unused-variable -Wno-maybe-uninitialized -Wno-attributes -Wno-implicit-function-declaration -Wno-aggressive-loop-optimizations -Wno-unused-but-set-variable -Wno-enum-compare -Wno-sizeof-pointer-memaccess -fgnu89-inline")
	SET(EXTRA_CXXFLAGS "-Wno-unused-but-set-variable -Wno-sign-compare")
ELSEIF (ARCH_OS STREQUAL arm-linux)
	SET(ARCH arm)
	SET(OS   LINUX)
	SET(EXTRA_CFLAGS "-Wno-cpp -Wno-unused-variable -Wno-maybe-uninitialized -Wno-attributes -Wno-implicit-function-declaration -Wno-aggressive-loop-optimizations -Wno-unused-but-set-variable -Wno-enum-compare -Wno-sizeof-pointer-memaccess -fgnu89-inline")
	SET(EXTRA_CXXFLAGS "-Wno-unused-but-set-variable -Wno-sign-compare")
ELSEIF (ARCH_OS STREQUAL csky-ecos)
	SET(ARCH csky)
	SET(OS   ECOS)
	SET(EXTRA_CFLAGS "-Wno-unused-variable")
ELSEIF (ARCH_OS STREQUAL csky-linux)
	SET(ARCH csky)
	SET(OS   LINUX)
	SET(EXTRA_CFLAGS "-Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-misleading-indentation -Wno-maybe-uninitialized")
	SET(EXTRA_CXXFLAGS "-Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-misleading-indentation -Wno-maybe-uninitialized")
ELSEIF (ARCH_OS STREQUAL csky-nos)
	SET(ARCH csky)
	SET(OS   NO)
	SET(CMAKE_C_FLAGS  "${CMAKE_C_FLAGS} -fno-builtin -nostdinc -nostdlib -Wno-unused-variable")
ELSEIF (ARCH_OS STREQUAL arm-nos)
	SET(ARCH arm)
	SET(OS   NO)
	SET(CMAKE_C_FLAGS  "${CMAKE_C_FLAGS} -fno-builtin -nostdinc -nostdlib -Wno-unused-but-set-variable -Wno-maybe-uninitialized -Wno-unused-variable")
ELSE()
	SET(ARCH i386)
	SET(OS   LINUX)
	SET(GOXCEED_PATH /usr/local/)
ENDIF()

SET(GOXCEED_PATH       $ENV{GX_PREFIX}/${ARCH_OS})

EXECUTE_PROCESS(COMMAND which ${CROSS_COMPILE}gcc
	OUTPUT_VARIABLE COMPILER_FULL_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
SET(CMAKE_C_COMPILER   ${COMPILER_FULL_PATH})

EXECUTE_PROCESS(COMMAND which ${CROSS_COMPILE}g++
	OUTPUT_VARIABLE COMPILER_FULL_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
SET(CMAKE_CXX_COMPILER   ${COMPILER_FULL_PATH})

ADD_DEFINITIONS(-D${ARCH} -D${OS}_OS)
ADD_DEFINITIONS(-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64)

# adjust the default behaviour of hte FIND_XXX() NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODULE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_INCLUDE ONLY)

SET(GXSRC_PATH ${CMAKE_CURRENT_SOURCE_DIR})
SET(CMAKE_INSTALL_PREFIX ${GOXCEED_PATH} )

SET(EXTRA_CFLAGS "${EXTRA_CFLAGS} -Werror ${GX_EXT_CFLAGS}")
SET(EXTRA_CXXFLAGS "${EXTRA_CXXFLAGS} -Werror ${GX_EXT_CFLAGS}")

SET(CMAKE_DEBUG_FLAGS       "-O0 -Wall -g -ggdb -DGXDBG -DAV_MEMORY_DEBUG -DGXLOG_LEVEL=${GX_LOGLEVEL}")
IF (GX_OPTIMIZE STREQUAL Os)
	SET(CMAKE_RELEASE_FLAGS     "-Os -Wall -g -Wundef -funsigned-char -fdata-sections -ffunction-sections -fno-exceptions ")
ELSEIF (GX_OPTIMIZE STREQUAL O0)
	SET(CMAKE_RELEASE_FLAGS     "-O0 -Wall -g -Wundef -funsigned-char -DAV_MEMORY_DEBUG -DAV_GXPLAYER_DEBUG")
ELSE()
	SET(CMAKE_RELEASE_FLAGS     "-O2 -Wall -g -Wundef -funsigned-char -fdata-sections -ffunction-sections -fno-exceptions -DAV_GXPLAYER_DEBUG")
ENDIF()

IF (GX_SSLLIB STREQUAL wolfssl)
	SET(CMAKE_RELEASE_FLAGS "${CMAKE_RELEASE_FLAGS} -DCONFIG_HAVE_WOLFSSL")
ENDIF()

IF (GX_SSLLIB STREQUAL openssl)
	SET(CMAKE_RELEASE_FLAGS "${CMAKE_RELEASE_FLAGS} -DCONFIG_HAVE_OPENSSL")
ENDIF()

IF (GX_XMLLIB_VERSION STREQUAL libxml2)
	SET(CMAKE_RELEASE_FLAGS "${CMAKE_RELEASE_FLAGS} -DCONFIG_OPENSOURCE_LIBXML2")
ENDIF()

#SET(CMAKE_RELEASE_FLAGS     "${CMAKE_RELEASE_FLAGS} -fsanitize=address")
SET(CMAKE_RELEASE_FLAGS     "${CMAKE_RELEASE_FLAGS} -DGXLOG_LEVEL=${GX_LOGLEVEL} ${GX_EXT_CFLAGS}")

SET(CMAKE_C_FLAGS           "${CMAKE_C_FLAGS} ${EXTRA_CFLAGS} ${GX_DEBUG_EXTRA} ${MULTIPROCESS} -D_GNU_SOURCE")
SET(CMAKE_CXX_FLAGS_DEBUG   "$ENV{CXXFLAGS} ${EXTRA_CXXFLAGS} ${CMAKE_DEBUG_FLAGS}")
SET(CMAKE_CXX_FLAGS_RELEASE "$ENV{CXXFLAGS} ${EXTRA_CXXFLAGS} ${CMAKE_RELEASE_FLAGS}")
SET(CMAKE_C_FLAGS_DEBUG     "${CMAKE_DEBUG_FLAGS}")
SET(CMAKE_C_FLAGS_RELEASE   "${CMAKE_RELEASE_FLAGS}")

INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/      )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/bus   )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/gxos    )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/libnl    )
INCLUDE_DIRECTORIES( ${CMAKE_BINARY_DIR}           )

FUNCTION(ADD_GX_LIBRARY name)
	# 生成动态库目标
	IF (OS STREQUAL LINUX)
		ADD_LIBRARY( ${name} SHARED ${ARGN} )
		SET_TARGET_PROPERTIES(${name} PROPERTIES CLEAN_DIRECT_OUTPUT 1)
		SET_TARGET_PROPERTIES(${name} PROPERTIES VERSION 1.0 SOVERSION 1)
		INSTALL( TARGETS ${name} LIBRARY DESTINATION ${GOXCEED_PATH}/lib/share)
	ENDIF()
	# 生成静态库目标
	ADD_LIBRARY( ${name}_static ${ARGN} )
	# 指定静态库的输出名称
	SET_TARGET_PROPERTIES(${name}_static PROPERTIES OUTPUT_NAME ${name})
	SET_TARGET_PROPERTIES(${name}_static PROPERTIES CLEAN_DIRECT_OUTPUT 1)
	INSTALL( TARGETS ${name}_static ARCHIVE DESTINATION ${GOXCEED_PATH}/lib)
ENDFUNCTION(ADD_GX_LIBRARY name)
