status_t gx_pm_tp_delete_by_sat(uint32_t * id_arry, uint32_t num) 
{
	int32_t sqlite_ret = 0;
	uint8_t sql_cmd[200];	//数据库的操作命令buffer
	uint32_t i = 0;
	int32_t count = 0;
	uint32_t * real_id = NULL;	//需要删除tp的卫星
	uint32_t real_num = 0;	//需要删除tp的卫星的数量
	real_id = (uint32_t *) GxCore_Malloc(sizeof(uint32_t) * num);
	
	    /*首先判断存不存在tp 或许可以用删除的返回值判断 但是,不知道是什么返回值
	       调试的时候可以试验下,如果使用这种方法判断得测试速度 如果慢 那么判断是否
	       有tp得操作也要做成事务 */ 
	    for (i = 0; i < num; i++) {
		sprintf((char *)sql_cmd, "select count(*) from tp_table where sat_id = %d", id_arry[i]);
		sqlite_ret = sqlite3_exec(db, 
					   (const char *)sql_cmd, 
					   (sqlite3_callback) & gx_pm_data_count_get_callback, 
					   (void *)&count, (char **)&err_msg);
		if (sqlite_ret != SQLITE_OK) {
			#ifdef GX_BUS_PM_DBUG
			PM_PRINTF("[PM]---delete tp by sat err !!\n ret = %s\n",err_msg);
			#endif
			GxCore_Free(real_id);
			return GXCORE_ERROR;
		}
		
		else if (count == 0) {
			continue;	//这颗卫星没有tp 判断下一颗卫星
		}
		
		else {
			real_id[real_num] = id_arry[i];
			real_num++;
		}
	}
	if (real_num == 0) {
		GxCore_Free(real_id);
		return GXCORE_SUCCESS;	//所有卫星都没有tp 相当于删除完成
	}
	
	    /*删除tp */ 
	    sqlite_ret = sqlite3_exec(db, (const char *)("begin transaction"), NULL, NULL, (char **)&err_msg);	//开始一个事务
	for (i = 0; i < real_num; i++) {
		sprintf((char *)sql_cmd, "delete from tp_table where sat_id = %d", real_id[i]);
		sqlite_ret = sqlite3_exec(db, (const char *)sql_cmd, NULL, NULL, (char **)&err_msg);
		if (sqlite_ret != SQLITE_OK) {
			#ifdef GX_BUS_PM_DBUG
			PM_PRINTF("[PM]---delete tp err !!\n ret = %s\n",err_msg);
			#endif
			sqlite_ret = sqlite3_exec(db, (const char *)("rollback transaction"), NULL, NULL, (char **)&err_msg);	//发生错误回滚事务
			
			    /*sqlite_ret = sqlite3_exec( db, 
			       "commit transaction", 
			       NULL,
			       NULL,
			       (char**)&err_msg );//提交事务 */ 
			    GxCore_Free(real_id);
			return GXCORE_ERROR;
		}
	}
	sqlite_ret = sqlite3_exec(db, (const char *)("commit transaction"), NULL, NULL, (char **)&err_msg);	//提交事务
	GxCore_Free(real_id);
	return GXCORE_SUCCESS;
}

