status_t gx_pm_sat_delete(uint32_t * id_arry, uint32_t num) 
{
	int32_t sqlite_ret = 0;
	uint8_t sql_cmd[200];	//数据库的操作命令buffer
	uint32_t i = 0;
	
	    /*删除sat */ 
	    sqlite_ret = sqlite3_exec(db, (const char *)("begin transaction"), NULL, NULL, (char **)&err_msg);	//开始一个事务
	for (i = 0; i < num; i++) {
		sprintf((char *)sql_cmd, "delete from sat_table where id = %d;", id_arry[i]);
		sqlite_ret = sqlite3_exec(db, (const char *)sql_cmd, NULL, NULL, (char **)&err_msg);
		if (sqlite_ret != SQLITE_OK) {
			#ifdef GX_BUS_PM_DBUG
			PM_PRINTF("[PM]---sat delete err !!\n ret = %s\n",err_msg);
			#endif
			sqlite_ret = sqlite3_exec(db, (const char *)("rollback transaction"), NULL, NULL, (char **)&err_msg);	//发生错误回滚事务
			
			    /*sqlite_ret = sqlite3_exec( db, 
			       "commit transaction", 
			       NULL,
			       NULL,
			       (char**)&err_msg );//提交事务 */ 
				
			    return GXCORE_ERROR;
		}
	}
	sqlite_ret = sqlite3_exec(db, (const char *)("commit transaction"), NULL, NULL, (char **)&err_msg);	//提交事务
	return GXCORE_SUCCESS;
}

int32_t gx_pm_tp_data_get_callback(void *para, int n_column, int8_t ** value, int8_t ** column_name)
{
	GxBusPmDataTP * temp = NULL;
	uint32_t num = 0;
	int32_t sqlite_ret = 0;
	uint8_t sql_cmd[500];	//数据库的操作命令buffer
	uint8_t **dbResult;	//
	uint32_t row = 0;
	uint32_t column = 0;
	GxBusPmDataSatType type = GXBUS_PM_SAT_S;
	num = ((struct gx_pm_data_get *)para)->num;
	temp = (GxBusPmDataTP *) (((struct gx_pm_data_get *)para)->tp);
	if (g_count == num) {
		#ifdef GX_BUS_PM_DBUG
		GX_BUS_PM_PRINTF("[PM]---get tp err !!\n");
		#endif
		return -1;
	}
	temp[g_count].id = atoi((const char *)value[0]);
	temp[g_count].sat_id = atoi((const char *)value[1]);
	temp[g_count].frequency = atoi((const char *)value[2]);
	
	    /*获得tp的type */ 
	    sprintf((char *)sql_cmd, "select type from sat_table where id='%d';", temp[g_count].sat_id);
	sqlite_ret = sqlite3_get_table(db, (const char *)sql_cmd, (char ***)&dbResult, (int *)&row, (int *)&column, 
					(char **)&err_msg);
	if (sqlite_ret != SQLITE_OK) {
		#ifdef GX_BUS_PM_DBUG
		PM_PRINTF("[PM]---get tp err !!\n ret = %s\n",err_msg);
		#endif
		return -1;
	}
	type = (GxBusPmDataSatType)atoi((const char *)dbResult[1]);	//dbResult[0]是字段名 dbResult[1]是字段值
	sqlite3_free_table((char **)dbResult);
	switch (type) {
	case GXBUS_PM_SAT_S:
		temp[g_count].tp_s.symbol_rate = atoi((const char *)value[3]);	//
		temp[g_count].tp_s.polar = atoi((const char *)value[4]);
		break;
	case GXBUS_PM_SAT_C:
		temp[g_count].tp_c.symbol_rate = atoi((const char *)value[3]);	//
		temp[g_count].tp_c.modulation = atoi((const char *)value[4]);
		break;
	case GXBUS_PM_SAT_T:
		break;
	default:
		return -1;
		break;
	}
	g_count++;
	return 0;
}

status_t gx_pm_tp_update_command_create(GxBusPmDataTP * tp, uint8_t * sql_cmd) 
{
	uint8_t sql_cmd_temp[300];	//数据库的操作命令buffer
	uint8_t **dbResult;	//
	uint32_t row = 0;
	uint32_t column = 0;
	int32_t sqlite_ret = 0;
	GxBusPmDataSatType type = GXBUS_PM_SAT_S;
	
	    /*获得tp类型 */ 
	    sprintf((char *)sql_cmd_temp, "select type from sat_table where id=%d;", tp->sat_id);
	sqlite_ret =
	    sqlite3_get_table(db, (const char *)sql_cmd_temp, (char ***)&dbResult, (int *)&row, (int *)&column,
