int32_t gx_pm_sat_data_get_callback(void *para, int n_column, int8_t ** value, int8_t ** column_name)
{
	GxBusPmDataSat * temp = NULL;
	uint32_t num = 0;
	num = ((struct gx_pm_data_get *)para)->num;
	temp = (GxBusPmDataSat *) (((struct gx_pm_data_get *)para)->sat);
	if (g_count == num) {
		return -1;
	}
	temp[g_count].id = atoi((const char *)value[0]);
	temp[g_count].type = (GxBusPmDataSatType)atoi((const char *)value[1]);
	temp[g_count].tuner = (GxBusPmDataSatTuner)atoi((const char *)value[2]);
	switch (temp[g_count].type) {
	case GXBUS_PM_SAT_S:
		temp[g_count].sat_s.lnb1 = atoi((const char *)value[3]);	//
		temp[g_count].sat_s.lnb_power = atoi((const char *)value[4]);
		temp[g_count].sat_s.lnb2 = atoi((const char *)value[5]);
		temp[g_count].sat_s.switch_22K = atoi((const char *)value[6]);
		temp[g_count].sat_s.diseqc_version = atoi((const char *)value[7]);
		temp[g_count].sat_s.diseqc10 = atoi((const char *)value[8]);
		temp[g_count].sat_s.diseqc11 = atoi((const char *)value[9]);
		temp[g_count].sat_s.diseqc12_pos = atoi((const char *)value[10]);
		temp[g_count].sat_s.lnb_type = atoi((const char *)value[11]);
		temp[g_count].sat_s.switch_12V = atoi((const char *)value[12]);
		temp[g_count].sat_s.longitude_direct = atoi((const char *)value[13]);
		memcpy(temp[g_count].sat_s.sat_name, value[14], strlen((const char *)value[14]));
		temp[g_count].sat_s.longitude = atoi((const char *)value[15]);
		break;
	case GXBUS_PM_SAT_C:
		break;
	case GXBUS_PM_SAT_T:
		break;
	default:
		return -1;
		break;
	}
	g_count++;
	return 0;
}

