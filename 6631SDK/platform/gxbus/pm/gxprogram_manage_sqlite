	real_id_arry = (uint32_t*)GxCore_Malloc(sizeof(uint32_t) * (num + 1));
	memcpy(real_id_arry, id_arry, sizeof(uint32_t) * num);
	real_id_arry[num] = target_id;
	pos_get.i = 0;
	pos_get.pos_id_arry = pos_arry;
	
	    /*获取传下来的所有id的pos */ 
	    for (i = 0; i < num + 1; i++) {
		sprintf((char *)sql_cmd, "select pos from prog_table where id = %d;", real_id_arry[i]);
		sqlite_ret = sqlite3_exec(db, 
					   (const char *)sql_cmd, 
					   (sqlite3_callback) & gx_pm_prog_pos_id_get_callback, 
					   (void *)&pos_get, (char **)&err_msg);
		if (sqlite_ret != SQLITE_OK) {
			return GXCORE_ERROR;
		}
	}
	if (pos_get.i != num + 1) {
		return GXCORE_ERROR;
	}
	*min = pos_arry[0];
	*max = pos_arry[0];
	for (i = 0; i < pos_get.i; i++) {
		*min = (*min) < (pos_arry[i]) ? (*min) : (pos_arry[i]);
		*max = (*max) > (pos_arry[i]) ? (*max) : (pos_arry[i]);
	}
	GxCore_Free(pos_arry);
	GxCore_Free(real_id_arry);
	return GXCORE_SUCCESS;
}

static uint8_t gx_pm_prog_id_exist_check(uint32_t source_id, uint32_t * id_arry, uint32_t num) 
{
	uint32_t i;
	for (i = 0; i < num; i++) {
		if (id_arry[i] == source_id) {
			return 0;
		}
	}
	return 1;
}

status_t gx_pm_prog_before_after_buff_init(uint32_t * before_target_id, uint32_t * after_target_id,
					     uint32_t * before_count, uint32_t * after_count, uint32_t max_pos,
					     uint32_t min_pos, uint32_t target_id_pos, uint32_t * id_arry,
					     uint32_t num) 
{
	int32_t sqlite_ret = 0;
	uint8_t sql_cmd[200];	//数据库的操作命令buffer
	uint32_t *id_temp;
	uint32_t count_temp = 0;
	uint32_t count = 0;
	uint32_t i = 0;
	
//      uint32_t j =0;
	struct gx_pm_prog_pos_get pos_get;
	
	    //该空间应该是所要修改的全部id数量那么大
	    id_temp = (uint32_t*)GxCore_Malloc(sizeof(uint32_t) * ((*before_count + num + 1)));
	
	    /*获取before_target_id */ 
	    pos_get.i = 0;
	pos_get.pos_id_arry = id_temp;
	sprintf((char *)sql_cmd, "select id from prog_table where pos<%d and pos>%d order by pos;", target_id_pos,
		 min_pos);
	sqlite_ret =
	    sqlite3_exec(db, (const char *)sql_cmd, (sqlite3_callback) & gx_pm_prog_pos_id_get_callback,
			  (void *)&pos_get, (char **)&err_msg);
	if (sqlite_ret != SQLITE_OK) {
		return GXCORE_ERROR;
	}
	count_temp = pos_get.i;
	
	    /*去除掉所要移动的id */ 
	    if (count_temp != 0) {
		for (i = 0; i < count_temp; i++) {
			if (gx_pm_prog_id_exist_check(id_temp[i], id_arry, num)) {
				before_target_id[count] = id_temp[i];
				count++;
			}
		}
		*before_count = count;
	}
	
	else {
		*before_count = 0;
	}
	
	    /*获取after_target_id */ 
	    pos_get.i = 0;
	pos_get.pos_id_arry = id_temp;
	sprintf((char *)sql_cmd, "select id from prog_table where pos<%d and pos>%d order by pos;", max_pos,
		 target_id_pos);
	sqlite_ret =
	    sqlite3_exec(db, (const char *)sql_cmd, (sqlite3_callback) & gx_pm_prog_pos_id_get_callback,
			  (void *)&pos_get, (char **)&err_msg);
	if (sqlite_ret != SQLITE_OK) {
		return GXCORE_ERROR;
	}
	count_temp = pos_get.i;
	count = 0;
	
	    /*去除掉所要移动的id */ 
	    if (count_temp != 0) {
		for (i = 0; i < count_temp; i++) {
			if (gx_pm_prog_id_exist_check(id_temp[i], id_arry, num)) {
				after_target_id[count] = id_temp[i];
				count++;
			}
		}
		*after_count = count;
	}
	
	else {
		*after_count = 0;
	}
	GxCore_Free(id_temp);
	return GXCORE_SUCCESS;
}

status_t gx_pm_prog_pos_update(uint32_t * real_id_arry, uint32_t * real_pos_arry, uint32_t num) 
{
	int32_t sqlite_ret = 0;
	uint8_t sql_cmd[200];	//数据库的操作命令buffer
	uint32_t i = 0;
	sqlite_ret = sqlite3_exec(db, (const char *)("begin transaction"), NULL, NULL, (char **)&err_msg);	//开始一个事务
	for (i = 0; i < num; i++) {
		sprintf((char *)sql_cmd, "update prog_table set pos = %d where id = %d;", real_pos_arry[i],
			 real_id_arry[i]);
		sqlite_ret = sqlite3_exec(db, (const char *)sql_cmd, NULL, NULL, (char **)&err_msg);
		if (sqlite_ret != SQLITE_OK) {
			sqlite_ret = sqlite3_exec(db, (const char *)("rollback transaction"), NULL, NULL, (char **)&err_msg);	//发生错误回滚事务
			return GXCORE_ERROR;
		}
	}
	sqlite_ret = sqlite3_exec(db, (const char *)("commit transaction"), NULL, NULL, (char **)&err_msg);	//提交事务
	return GXCORE_SUCCESS;
}

status_t gx_pm_prog_command_create(enum gx_pm_prog_command_type type,uint8_t * sql_cmd)
{
	uint8_t command_type[50] ={0};
	uint8_t command_stream_type[50] = {0};
	uint8_t command_group_type[100] = {0};
	uint8_t command_taxis_type[100] = {0};
	uint8_t letter = 0;
	uint8_t letter1 = 0;
	uint32_t fav_id = 0;
	GxBusSysInfo sys = {{0}};
	#ifdef GX_BUS_PM_DBUG
	;//GxBus_SysInfoGet(&sys);
	#else
	GxBus_SysInfoGet(&sys);
	#endif
	switch(type)
	{
		case GET_NUM:
			sprintf((char*)command_type,"select count(*) from prog_table");
			break;

		case GET_INFO:
			sprintf((char*)command_type,"select * from prog_table");
			break;
	}
	sprintf((char*)command_stream_type," where service_type = %d",sys.view_info.stream_type);
	switch(sys.view_info.group_mode)
	{
		case GROUP_MODE_ALL://all
			//sprintf((char*)command_group_type,"");
			break;

		case GROUP_MODE_SAT://sat
			sprintf((char*)command_group_type," and sat_id = %d",sys.view_info.sat_id);
			break;

		case GROUP_MODE_FAV://fav
			fav_id = sys.view_info.fav_id-1;//id是从1开始的
			sprintf((char*)command_group_type," and ((favorite_flag>>%d)&1)>0",fav_id);
			break;
	}
	switch(sys.view_info.taxis_mode)
	{
		case TAXIS_MODE_NON://all
			sprintf((char*)command_taxis_type," order by pos");
			break;

		case TAXIS_MODE_CAS://sat
			sprintf((char*)command_taxis_type," and cas_id = %d order by pos",sys.view_info.cas_id);
			break;

		case TAXIS_MODE_LETTER://fav
			letter1 = letter = sys.view_info.letter_pos;
			if(letter == 0)//a~z
			{
				sprintf((char*)command_taxis_type," and ((prog_name>='A'\
													and prog_name<='Z')\
													or (prog_name>='a'\
													and prog_name <='z'))\
													order by prog_name");
			}
			else if(letter == 27)//other
			{
				sprintf((char*)command_taxis_type," and ((prog_name<'A'\
													and prog_name>'Z')\
													or (prog_name<'a'\
													and prog_name >'z'))\
													order by prog_name");
			}
			else//某个字母
			{
				letter+=64;//大写
				letter1+=96;//小写
				sprintf((char*)command_taxis_type," and (prog_name like '%c%%'\
													or prog_name like '%c%%')\
													order by prog_name",letter,letter1);
			}
			
			break;

		case TAXIS_MODE_TP:
			sprintf((char*)command_taxis_type," and tp_id = %d order by pos",sys.view_info.tp_id);
			break;
	}
	sprintf((char*)sql_cmd,"%s%s%s%s",
			command_type,
			command_stream_type,
			command_group_type,
			command_taxis_type);

	return GXCORE_SUCCESS;
}

