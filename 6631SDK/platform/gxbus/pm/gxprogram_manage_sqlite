/**
 * @brief 		通过id获取prog的url信息,该信息主要是为了给player播放用的,prog_url的
 				空间是由使用接口的地方分配的 大小为 GX_PM_MAX_PROG_URL_SIZE
 * @param   	prog:所要获取url信息的prog
     			prog_url:获取的url信息的buffer
     			uint32_t size:buffer的大小 如果小于GX_PM_MAX_PROG_URL_SIZE会返回错误
     			

 * @return     	GXCORE_SUCCESS:执行正常
 				GXCORE_ERROR:执行失败
 */
status_t GxBus_PmProgUrlGet(GxBusPmDataProg* prog, int8_t* prog_url,uint32_t size)
{
	uint32_t tp_id = 0;
	uint32_t sat_id = 0;
	int32_t stream_count = 0;
	int32_t i = 0;
	GxBusPmDataStream * stream_arry = NULL;
	GxBusPmDataStream stream = {0};
	status_t ret = GXCORE_SUCCESS;
	GxBusPmDataTP tp = {0};
	GxBusPmDataSat sat = {0};

	if(prog == NULL||prog_url == NULL)
	{
		#ifdef GX_BUS_PM_DBUG
		GX_BUS_PM_PRINTF("[PM]---params err!!\n");
		#endif
		return GXCORE_ERROR;
	}
	if(size<GX_PM_MAX_PROG_URL_SIZE)
	{
		#ifdef GX_BUS_PM_DBUG
		GX_BUS_PM_PRINTF("[PM]---buffer size err!!\n");
		#endif
		return GXCORE_ERROR;
	}
	tp_id = prog->tp_id;
	sat_id = prog->sat_id;

	GxBus_PmTpGetById(tp_id,&tp);
	GxBus_PmSatGetById(sat_id,&sat);
	stream_count = GxBus_PmStreamNumGet(prog->id);
	if(stream_count != -1)
	{
		stream_arry = (GxBusPmDataStream *)GxCore_Malloc(sizeof(GxBusPmDataStream) * stream_count);
		GxBus_PmStreamGet(prog->id,stream_count,stream_arry);
		for(i=0; i<stream_count; i++)
		{
			if(stream_arry[i].audio_type == 0)//pcm
			{
				stream.audio_pid = stream_arry[i].audio_pid;
				break;
			}
		}
		if(i == stream_count)//没有pcm
		{
			stream.audio_pid = 0x1fff;
		}
		GxCore_Free(stream_arry);
	}
	else
	{
		stream.audio_pid = 0x1fff;
	}
	switch(sat.type)
	{
		case GXBUS_PM_SAT_S:
			sprintf((char *)prog_url,"dvbs://fre=%d&polar=%d&symbol=%d&22k=%d&vpid=%d&apid=%d&pcrpid=%d",
				    tp.frequency,
				    tp.tp_s.polar,
				    tp.tp_s.symbol_rate,
				    sat.sat_s.switch_22K,
				    prog->video_pid,
				    stream.audio_pid,
				    prog->pcr_pid);
			#ifdef GX_BUS_PM_DBUG
			PM_PRINTF("[PM]---prog_url = %s!!\n",prog_url);
			#endif
			break;

		case GXBUS_PM_SAT_C:
			sprintf((char *)prog_url,"dvbc://fre=%d&qam=%d&symbol=%d&vpid=%d&apid=%d&pcrpid=%d",
				    tp.frequency,
				    tp.tp_c.modulation,
				    tp.tp_c.symbol_rate,
				    prog->video_pid,
				    stream.audio_pid,
				    prog->pcr_pid);
			#ifdef GX_BUS_PM_DBUG
			PM_PRINTF("[PM]---prog_url = %s!!\n",prog_url);
			#endif
			break;

		case GXBUS_PM_SAT_T:
			break;

		default:
			#ifdef GX_BUS_PM_DBUG
			GX_BUS_PM_PRINTF("[PM]---sat type err!!\n");
			#endif
			ret = GXCORE_ERROR;
			break;
	}
	
	return ret;
}

/**
 * @brief 		通过id修改节目信息中以bool形式表示的信息,比如skip:0-跳过 1-不跳过
 * @param   	type:修改的内容
 				id_arry:所要修改的id
     			num:所要修改的节目的数量

 * @return     	GXCORE_SUCCESS:执行正常
 				GXCORE_ERROR:执行失败
 */ 
    status_t GxBus_PmProgBoolModify(GxBusPmProgModifyBoolType type, uint32_t * id_arry, uint32_t num) 
{
	uint32_t i = 0;
	uint32_t flag = 0;
	int32_t sqlite_ret = 0;
	uint32_t count = 0;
	uint8_t sql_cmd[200];	//数据库的操作命令buffer
	uint8_t **dbResult;	//
	uint32_t row = 0;
	uint32_t column = 0;

	sprintf((char *)sql_cmd,"select count(*) from prog_table;");
	sqlite_ret = sqlite3_exec(db, 
				   (const char *)sql_cmd, 
				   (sqlite3_callback) & gx_pm_data_count_get_callback, 
				   (void *)&count, (char **)&err_msg);
	if((num==0)||(num>count)||(sqlite_ret != SQLITE_OK)||(id_arry == NULL))
	{
		#ifdef GX_BUS_PM_DBUG
		PM_PRINTF("[PM]---get prog bool modify err !!\nnum=%d ret = %s\n",num,err_msg);
		#endif
		return GXCORE_ERROR;
	}
	switch (type) {
	case GXBUS_PM_PROG_MODIFY_SKIP:
		sqlite_ret = sqlite3_exec(db, (const char *)("begin transaction"), NULL, NULL, (char **)&err_msg);	//开始一个事务
		for (i = 0; i < num; i++) {
			
			    /*获取原始数据 */ 
			    sprintf((char *)sql_cmd, "select skip_flag from prog_table where id = %d;", id_arry[i]);
			sqlite_ret = sqlite3_get_table(db, (const char *)sql_cmd, (char ***)&dbResult, (int *)&row, 
							(int *)&column, (char **)&err_msg);
			if (sqlite_ret != SQLITE_OK) {
				#ifdef GX_BUS_PM_DBUG
				PM_PRINTF("[PM]---get prog skip status err !!\n ret = %s\n",err_msg);
				#endif
				sqlite_ret = sqlite3_exec(db, (const char *)("commit transaction"), NULL, NULL, (char **)&err_msg);	//提交事务
				return GXCORE_ERROR;
			}
			
			    /*获取修改值 */ 
			    flag = !(atoi((const char *)dbResult[1]));	//dbResult[0]是字段名 dbResult[1]是字段值
			sqlite3_free_table((char **)dbResult);
			sprintf((char *)sql_cmd, "update prog_table set skip_flag = %d where id = %d;", flag,
				 id_arry[i]);
			sqlite_ret = sqlite3_exec(db, (const char *)sql_cmd, NULL, NULL, (char **)&err_msg);
			if (sqlite_ret != SQLITE_OK) {
				#ifdef GX_BUS_PM_DBUG
				PM_PRINTF("[PM]---modify prog skip err !!\n ret = %s\n",err_msg);
				#endif
				sqlite_ret = sqlite3_exec(db, (const char *)("rollback transaction"), NULL, NULL, (char **)&err_msg);	//发生错误回滚事务
				return GXCORE_ERROR;
			}
