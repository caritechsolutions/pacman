		break;
	case GXBUS_PM_PROG_MODIFY_LOCK:
		sqlite_ret = sqlite3_exec(db, (const char *)("begin transaction"), NULL, NULL, (char **)&err_msg);	//开始一个事务
		for (i = 0; i < num; i++) {
			
