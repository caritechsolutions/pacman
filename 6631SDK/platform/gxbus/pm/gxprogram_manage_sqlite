	switch (sat->type) {
	case GXBUS_PM_SAT_S:
		sprintf((char *)sql_cmd, "update sat_table set type = %d,\
							tuner = %d,\
							lnb1 = %d,\
							lnb_Power = %d,\
							lnb2 = %d,\
							switch_22k = %d,\
							diseqc_version = %d,\
							diseqc10 = %d,\
							diseqc11 = %d,\
							diseqc12pos = %d,\
							Lnb_type = %d,\
							switch_12V = %d,\
							longitude_direct = %d,\
							sat_name = '%s',\
							longitude = %d\
							where id = %d;", sat->type, sat->tuner, sat->sat_s.lnb1, sat->sat_s.lnb_power, sat->sat_s.lnb2, sat->sat_s.switch_22K, sat->sat_s.diseqc_version, sat->sat_s.diseqc10, sat->sat_s.diseqc11, sat->sat_s.diseqc12_pos, sat->sat_s.lnb_type, sat->sat_s.switch_12V, sat->sat_s.longitude_direct, sat->sat_s.sat_name, sat->sat_s.longitude, sat->id);
