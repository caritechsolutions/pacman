<?xml version="1.0" encoding="UTF-8"?>
<widget class="menulist">
	<property name="name" type="string" value="" hint="widget name||控件名称"/>
	<property name="style" type="string" value="default" hint="widget style||控件风格"/>
	<property name="rect" type="container" hint="widget postion||控件位置设置">
		<property name="x" type="u16" value="0" hint="x position||水平坐标"/>
		<property name="y" type="u16" value="0" hint="y position||垂直坐标"/>
		<property name="width" type="u16" value="0" hint="widget width||宽度"/>
		<property name="height" type="u16" value="0" hint="widget height||高度"/>
	</property>
	<property name="state" type="strselect" help="item||enable;disable;hide;show;focus" value="show" attr="optional" hint="widget initial state||控件初始显示状态"/>

	<property name="forecolor" type="container" hint="foreground color||初始颜色设置">
		<property name="unfocus" type="color" value="#000000" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#000000" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#000000" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="backcolor" type="container" hint="background color||背景颜色设置">
		<property name="unfocus" type="color" value="#A0FFA0" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#A0FFA0" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#A0FFA0" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="alignment" type="container" attr="optional" hint="widget alignment||对齐方式">
		<property name="h" type="strselect" help="item||left;hcentre;right" value="" hint="horizontal alignment||水平对齐"/>
		<property name="v" type="strselect" help="item||top;vcentre;bottom" value="" hint="vertical alignment||垂直对齐"/>
	</property>
	<property name="mirror" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="widget mirror state||组件镜像状态"/>
	<property name="keypress_revert" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="key (left/right) revert state||(左右)按键反转状态"/>

	<property name="font" type="font" value="" attr="optional" hint="widget font||控件字体"/>
	<property name="unfocus_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select unfocus image file||选择非焦点时的图像文件"/>
	<property name="focus_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select focus image file||选择焦点时的图像文件"/>
	<property name="disable_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select disabled image file||选择被禁用时的图像文件"/>
	<property name="unfocus_item_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select unfocus image file||选择非焦点时的背景文件"/>
	<property name="focus_item_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select focus image file||选择焦点时的背景文件"/>
	<property name="disable_item_image" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.jpg *gif);;All files (*.*)||path||image" attr="optional" hint="select disabled image file||选择被禁用时的背景文件"/>
</widget>

