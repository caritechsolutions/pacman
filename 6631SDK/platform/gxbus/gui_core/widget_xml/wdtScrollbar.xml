<?xml version="1.0" encoding="UTF-8"?>
<widget class="scrollbar">
	<property name="name" type="string" value="" hint="widget name||控件名称"/>
	<property name="style" type="string" value="default" hint="widget style||控件风格"/>
	<property name="rect" type="container" hint="widget postion||控件位置设置">
		<property name="x" type="u16" value="0" attr="disable" hint="x position||水平坐标"/>
		<property name="y" type="u16" value="0" attr="disable" hint="y position||垂直坐标"/>
		<property name="width" type="u16" value="0" hint="widget width||宽度"/>
		<property name="height" type="u16" value="0" attr="disable" hint="widget height||高度"/>
	</property>
	<property name="state" type="strselect" help="item||enable;disable;hide;show;focus" value="show" attr="optional"  hint="widget initial state||控件初始显示状态"/>

	<property name="forecolor" type="container" hint="foreground color||前景颜色设置">
		<property name="unfocus" type="color" value="#000000" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#000000" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#000000" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="backcolor"  type="container" attr="optional" hint="background color||背景颜色设置">
		<property name="unfocus" type="color" value="#808080" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#808080" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#808080" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="mirror" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="widget mirror state||组件镜像状态"/>
	<property name="keypress_revert" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="key (left/right) revert state||(左右)按键反转状态"/>

	<property name="back_img" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.gif *.jpg);;All files (*.*)||path||image" attr="optional" hint="background image||背景图片"/>
	<property name="arrow_up" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.gif *.jpg);;All files (*.*)||path||image" attr="optional" hint="up arrow image||上箭头图片"/>
	<property name="arrow_down" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.gif *.jpg);;All files (*.*)||path||image" attr="optional" hint="down arrow image||下箭头图片"/>
	<property name="fore_img" type="file" value="" help="filter||Images (*.bmp *.png *.xpm *.gif *.jpg);;All files (*.*)||path||image" attr="optional" hint="foreground image||前景图片"/>

	<property name="format" type="strselect" help="item||scroll_show;scroll_hide" value="scroll_show" attr="optional" hint="progress bar format||显示模式"/>
	<property name="scale_bar" type="strselect" help="enable||disable" value="enable" attr="optional" hint="bar height adjust||位置条长度根据文字或列表长度自适应变化"/>

	<signal name = "create" value=""/>
	<signal name = "destroy" value=""/>
</widget>

