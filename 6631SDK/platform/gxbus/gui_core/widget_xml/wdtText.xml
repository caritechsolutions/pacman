<?xml version="1.0" encoding="UTF-8"?>
<widget class="text">
	<property name="name" type="string" value="" hint="widget name||控件名称"/>
	<property name="style" type="string" value="default" hint="widget style||控件风格"/>
	<property name="rect" type="container" hint="widget postion||控件位置设置">
		<property name="x" type="u16" value="0" hint="x position||水平坐标"/>
		<property name="y" type="u16" value="0" hint="y position||垂直坐标"/>
		<property name="width" type="u16" value="0" hint="widget width||宽度"/>
		<property name="height" type="u16" value="0" hint="widget height||高度"/>
	</property>
	<property name="string_rect" type="container" hint="widget postion||控件中文字位置设置">
		<property name="x" type="u16" value="0" hint="x position||横座标"/>
		<property name="y" type="u16" value="0" hint="y postion||纵座标"/>
		<property name="width" type="u16" value="0" hint="widget width||宽度"/>
		<property name="height" type="u16" value="0" hint="widget height||高度"/>
	</property>
	<property name="state" type="strselect" help="item||enable;disable;hide;show;focus" value="show" attr="optional" hint="widget initial state||控件初始显示状态"/>

	<property name="forecolor" type="container" hint="foreground color||前景颜色设置">
		<property name="unfocus" type="color" value="#000000" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#000000" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#000000" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="backcolor" type="container" hint="background color||背景颜色设置">
		<property name="unfocus" type="color" value="#808080" hint="unfocus color||非焦点时的颜色"/>
		<property name="focus" type="color" value="#808080" hint="focus color||焦点时的颜色"/>
		<property name="disable" type="color" value="#808080" hint="disable color||被禁用时的颜色"/>
	</property>
	<property name="mirror" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="widget mirror state||组件镜像状态"/>
	<property name="keypress_revert" type="strselect" help="item||enable;disable" value="disable" attr="optional" hint="key (left/right) revert state||(左右)按键反转状态"/>

	<property name="alignment" type="container" attr="optional" hint="widget alignment||对齐方式">
		<property name="h" type="strselect" help="item||left;hcentre;right" value="hcentre" attr="optional" hint="horizontal alignment||水平对齐"/>
		<property name="v" type="strselect" help="item||top;vcentre;bottom" value="vcentre" attr="optional" hint="vertical alignment||垂直对齐"/>
	</property>

	<property name="string" type="string" value="" hint="widget text||控件的显示文本"/>
	<property name="format" type="strselect" help="item||static;roll_r2l;roll_l2r;roll_b2t;roll_t2b;fix_r2l;automatic" value="static" hint="text show format||文本显示方式"/>

	<property name="font" type="font" value="" attr="optional" hint="widget font||控件字体"/>
	<property name="time" type="u16" value="0" attr="optional" hint="refresh milliseconds||滚动刷新间隔(毫秒)"/>
	<property name="encoding" type="strselect" help="item||utf8;gb2312;gbk;big5" value="utf8" attr="optional" hint="encoding type||编码类型"/>
	<property name="step" type="u16" value="1" attr="optional" hint="rolling string step||滚动字幕步进量"/>
	<property name="fill" type="strselect" value="disable" help="enable||disable" attr="optional" hint="rolling fill||滚动刷新时每次填充"/>
	<property name="auto_width" type="strselect" value="false" help="true||false" attr="optional" hint="automatic width||根据字符串自动调整组件宽度"/>
	<property name="auto_height" type="strselect" value="false" help="true||false" attr="optional" hint="automatic height||根据字符串自动调整组件高度"/>
	<property name="inter_char" type="u16" value="0" attr="optional" hint="space between chars||字间距"/>
	<property name="inter_line" type="u16" value="0" attr="optional" hint="space between lines||行间距"/>
	<property name="roll_mode" type="strselect" help="item||antiflicker;smooth" value="antiflicker" attr="optional" hint="rolling mode||滚动方式"/>
	<property name="typeset" type="strselect" help="item||l2r;r2l" value="r2l" attr="optional" hint="typeset||排版方式"/>

	<signal name = "create" value=""/>
	<signal name = "destroy" value=""/>
</widget>

