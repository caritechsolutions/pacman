mainmenu "NationalChip GxDownloader Configuration"

choice
	prompt "CPU CHIP SELECT"
	default TAURUS

	config GX3113C
		bool "GX3113C"
	config GX3211
		bool "GX3211"
	config GX6605S
		bool "GX6605S"
	config SIRIUS
		bool "SIRIUS"
	config TAURUS
		bool "TAURUS"
	config GEMINI
		bool "GEMINI"
