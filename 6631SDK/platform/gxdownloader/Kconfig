		bool "CANOPUS"
	config VEGA
		bool "VEGA"
	config SCORPIO
		bool "SCORPIO"
	config SCORPIO_TAURUS
		bool "SCORPIO_TAURUS"
endchoice

config ENABLE_UPGRADE
	bool "ENABLE UPGRADE"
	default y

if ENABLE_UPGRADE
menu "Update method select"
	config ENABLE_OTA
		bool "ENABLE OTA"
		default y
	config ENABLE_USB_UPGRADE
		bool "ENABLE USB"
		default n
	config ENABLE_NET_HTTP
		bool "ENABLE NET HTTP"
		default n
		select NET
	config ENABLE_NET_TFTP
		bool "ENABLE NET TFTP"
		default n
		select NET
endmenu
endif


choice
	prompt "GUI lib select"
	default ENABLE_GDI

config ENABLE_GDI
	bool "ENABLE GDI"

config ENABLE_GUI
	bool "ENABLE GUI"

config NO_GUI
	bool "NO GUI"
endchoice

if ENABLE_GDI || ENABLE_GUI
config ENABLE_LOGO
	bool "ENABLE LOGO"
	default y
endif

config NET
	bool "Network support"
	depends on ENABLE_NET_HTTP

if NET
config WIFI_SUPPORT
	bool "WIFI support"
	default y

if WIFI_SUPPORT
menu "WIFI model select"
	config WIFI_MT7601
		bool "WIFI MT7601"
		default y
	config WIFI_RT5370
		bool "WIFI RT5370"
		default n
	config WIFI_RTL8188FU
		bool "WIFI RTL8188FU"
		default n
endmenu
endif

config ETH_SUPPORT
	bool "ETH support"
	default n

config USB_ETH_SUPPORT
	bool "USB ETH support"
	default n
endif

config ENABLE_PANEL
	bool "ENABLE PANEL"
	default n

config ENABLE_IRR
	bool "ENABLE IRR"
	default n

config ENABLE_MINIFS
	bool "ENABLE MINIFS"
	default n

config CHECK_TIME
	int "check time"
	default 500
	help
         Start to enter the configuration unit of the interaction time
         in milliseconds, configure 0 to not interact


config DLP_PATH
	string "DLP path"
	default "OEM"
	help
         the format of partition path of dlp and backup_dlp is not include "/", like "OEM"
         oppositely, the format of minifs path of dlp and backup_dlp_path is include "/"
         and must be prefixed with "/home/gx", like "/home/gx/oem.ini"
         using different path format to determine how to read and write dlp and backup_dlp file

config BACKUP_DLP_PATH
	string "Backup DLP path"
	default "BACKOEM"
	help
         the format of partition path of dlp and backup_dlp is not include "/", like "OEM"
         oppositely, the format of minifs path of dlp and backup_dlp_path is include "/"
         and must be prefixed with "/home/gx", like "/home/gx/oem.ini"
         using different path format to determine how to read and write dlp and backup_dlp file

