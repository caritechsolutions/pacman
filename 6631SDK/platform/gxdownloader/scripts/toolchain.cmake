SET(ARCH_OS $ENV{ARCH_OS})
SET(BUG $ENV{BUG})
SET(GX_DEBUG_HOLE $ENV{GX_DEBUG_HOLE})
SET(GX_OPTIMIZE $ENV{GX_OPTIMIZE})
SET(GX_LOGLEVEL $ENV{GX_LOGLEVEL})
SET(GX_EXT_CFLAGS $ENV{GX_EXT_CFLAGS})

SET(CMAKE_C_COMPILER_FORCED TRUE)
SET(CMAKE_CXX_COMPILER_FORCED TRUE)

IF (ARCH_OS STREQUAL arm-ecos)
	SET(ARCH arm)
	SET(OS   ECOS)
	SET(TOOLCHAIN_PREFIX arm-none-eabi-)
ELSEIF (ARCH_OS STREQUAL arm-linux)
	SET(ARCH arm)
	SET(OS   LINUX)
	SET(TOOLCHAIN_PREFIX arm-linux-uclibcgnueabihf-)
ELSEIF (ARCH_OS STREQUAL csky-ecos)
	SET(ARCH csky)
	SET(OS   ECOS)
	SET(TOOLCHAIN_PREFIX csky-elf-)
ELSEIF (ARCH_OS STREQUAL csky-linux)
	SET(ARCH csky)
	SET(OS   LINUX)
	SET(TOOLCHAIN_PREFIX csky-linux-)
ELSEIF (ARCH_OS STREQUAL csky-nos)
	SET(ARCH csky)
	SET(OS   NO)
	SET(TOOLCHAIN_PREFIX csky-elf-)
	SET(CMAKE_C_FLAGS  "${CMAKE_C_FLAGS} -DNO_OS -fno-builtin -nostdinc -nostdlib")
ELSEIF (ARCH_OS STREQUAL arm-nos)
	SET(ARCH arm)
	SET(OS   NO)
	SET(TOOLCHAIN_PREFIX arm-none-eabi-)
	SET(CMAKE_C_FLAGS  "${CMAKE_C_FLAGS} -DNO_OS -fno-builtin -nostdinc -nostdlib -Wno-unused-but-set-variable -Wno-maybe-uninitialized")
ELSE()
	SET(ARCH i386)
	SET(OS   LINUX)
	SET(GOXCEED_PATH /usr/local/)
ENDIF()

SET(GOXCEED_PATH       $ENV{GX_PREFIX}/${ARCH_OS})

EXECUTE_PROCESS(COMMAND which ${TOOLCHAIN_PREFIX}gcc
	OUTPUT_VARIABLE COMPILER_FULL_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
SET(CMAKE_C_COMPILER   ${COMPILER_FULL_PATH})

EXECUTE_PROCESS(COMMAND which ${TOOLCHAIN_PREFIX}g++
	OUTPUT_VARIABLE COMPILER_FULL_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
SET(CMAKE_CXX_COMPILER   ${COMPILER_FULL_PATH})

ADD_DEFINITIONS(-D${ARCH} -D${OS}_OS)
ADD_DEFINITIONS(-D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64)

# adjust the default behaviour of hte FIND_XXX() NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODULE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_INCLUDE ONLY)

SET(GXSRC_PATH ${CMAKE_CURRENT_SOURCE_DIR})
SET(CMAKE_INSTALL_PREFIX ${GOXCEED_PATH} )

SET(CMAKE_DEBUG_FLAGS       "-O0 -g -ggdb")
IF (GX_OPTIMIZE STREQUAL Os)
	SET(CMAKE_RELEASE_FLAGS     "-Os -fdata-sections -ffunction-sections")
ELSEIF (GX_OPTIMIZE STREQUAL O0)
	SET(CMAKE_RELEASE_FLAGS     "-O0 -g -ggdb")
ELSE()
	SET(CMAKE_RELEASE_FLAGS     "-O2 -fdata-sections -ffunction-sections")
ENDIF()

IF (GX_DEBUG_HOLE EQUAL 1)
	SET(CMAKE_RELEASE_FLAGS "${CMAKE_RELEASE_FLAGS} -DDBG_QM_MALLOC")
	SET(CMAKE_DEBUG_FLAGS   "${CMAKE_DEBUG_FLAGS} -DDBG_QM_MALLOC")
ENDIF()

SET(CMAKE_C_FLAGS           "${CKSY_LINUX_BUG} ${CMAKE_C_FLAGS} ${GXCFLAGS} ${GX_EXT_CFLAGS} -Wall -Wundef -funsigned-char -D_GNU_SOURCE")
SET(CMAKE_CXX_FLAGS_DEBUG   "$ENV{CXXFLAGS} ${CMAKE_DEBUG_FLAGS} ")
SET(CMAKE_CXX_FLAGS_RELEASE "$ENV{CXXFLAGS} ${CMAKE_RELEASE_FLAGS}")

SET(CMAKE_C_FLAGS_DEBUG     "${CMAKE_CXX_FLAGS_DEBUG} -DGXLOG_LEVEL=${GX_LOGLEVEL}")
SET(CMAKE_C_FLAGS_RELEASE   "${CMAKE_CXX_FLAGS_RELEASE} ${CMAKE_C_FLAGS} -DGXLOG_LEVEL=${GX_LOGLEVEL}")
message(${CMAKE_C_FLAGS_RELEASE})
message(${CMAKE_C_FLAGS_DEBUG})

INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/    )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/bus )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/av  )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/sys )
INCLUDE_DIRECTORIES( ${GOXCEED_PATH}/include/gxos)
INCLUDE_DIRECTORIES( ${CMAKE_BINARY_DIR}         )

FUNCTION(ADD_GX_LIBRARY name)
	ADD_LIBRARY( ${name} ${ARGN} )
	INSTALL(TARGETS ${name}
		ARCHIVE DESTINATION ${GOXCEED_PATH}/lib)
ENDFUNCTION(ADD_GX_LIBRARY name)
