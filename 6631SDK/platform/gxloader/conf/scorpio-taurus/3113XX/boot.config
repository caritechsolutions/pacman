#
# Configurations for Boot Loader
#

##############################################################
#
## I   SOC architechture & boot configurations
#
##############################################################
# ARCH: ARM/CSKY
CONFIG_ARCH = CSKY

# chip series: gx3113/gx3200/gx3201/gx6605s
CHIP_CORE = scorpio_taurus

# Board type
CHIP_BOARD = 3113XX

# CONFIG DEMOD: dvbs/dvbs2/dvbc/dvbt/dvbt2/dtmb/null
CONFIG_DEMOD = dvbc

# DRAM_SIZE用于计算loader链接的位置，这里按照最小的内存颗粒
DRAM_SIZE = 0x4000000
KERNEL_SIZE = 0x1400000

# SCORPIO_3113X1
DDR_TYPE = DDR3
DDR_FREQUENCY = 667000000
DDR_SIZE = 128
CONFIG_24M_XTAL = y

# SCORPIO_3113X5
# DDR_TYPE = DDR2
# DDR_FREQUENCY = 667000000
# DDR_SIZE = 64
# CONFIG_24M_XTAL = y

# taurus_3113U1
# DDR_TYPE = DDR3
# DDR_FREQUENCY = 533000000
# DDR_SIZE = 128
# CONFIG_24M_XTAL = y

# taurus_3113E1
# DDR_TYPE = DDR3
# DDR_FREQUENCY = 533000000
# DDR_SIZE = 128
# CONFIG_24M_XTAL = n

# taurus_3113U5
# DDR_TYPE = DDR2
# DDR_FREQUENCY = 400000000
# DDR_SIZE = 64
# CONFIG_24M_XTAL = y

# taurus_3113E5
# DDR_TYPE = DDR2
# DDR_FREQUENCY = 400000000
# DDR_SIZE = 64
# CONFIG_24M_XTAL = n

DDR_POS = BOTTOM

DDR3_128M_SCORPIO_PAR_INCLUDE = ddr3_qfn_667MHz_128MB.h
DDR2_64M_SCORPIO_PAR_INCLUDE = ddr2_qfn_667MHz_64MB.h
DDR3_128M_TAURUS_PAR_INCLUDE = ddr3_qfn_533MHz_128MB.h
DDR2_128M_TAURUS_PAR_INCLUDE = ddr2_qfn_533MHz_128MB.h
DDR2_64M_TAURUS_PAR_INCLUDE =  ddr2_qfn_400MHz_64MB.h

# CHIP_PACKAGE: QFN / LQFP
CONFIG_CHIP_PACKAGE = QFN

# usb Series resistance config, 10 / 2.2 / 0 Ω
USB_RESISTANCE = 0

# USB EYE DIAGRAM TEST
USB_EYE_DIAGRAM_TEST = n

# enable boot from usb storage
# Rely : ENABLE_USB
ENABLE_BOOT_FROM_USB = n

CONFIG_MULTI_CMDLINE = y
# cmdline config, if CMDLINE_VALUE = "" will not ENABLE_CMDLINE
#SCORPIO_3113X1
CMDLINE_VALUE = "mem=68564K videomem=60M hdcpmem=256K svpumem=812K mem_end console=ttyS0,115200 init=/init"
CMDLINE_VALUE1 = "mem=68564K videomem=60M hdcpmem=256K svpumem=812K mem_end console=ttyS0,115200 init=/init"

#SCORPIO_3113X5
CMDLINE_VALUE2 = "mem=23508K videomem=40M hdcpmem=256K svpumem=812K mem_end console=ttyS0,115200 init=/init"

#taurus_3113E1
CMDLINE_VALUE3 = "mem=68M videomem=60M mem_end console=ttyS0,115200 init=/init"

#taurus_3113E5
CMDLINE_VALUE4 = "mem=24M videomem=40M mem_end console=ttyS0,115200 init=/init"

#taurus_3113U1
CMDLINE_VALUE5 = "mem=68M videomem=60M mem_end console=ttyS0,115200 init=/init"

#taurus_3113U5
CMDLINE_VALUE6 = "mem=24M videomem=40M mem_end console=ttyS0,115200 init=/init"


# if you set <=0, you'll enter prompt directly
CONFIG_BOOTDELAY = -1

#############################################################
#
##II boot kernel type & decompress support
#
#############################################################
ENABLE_ZIMAGE = y
ENABLE_UIMAGE = y

ENABLE_ROOTFS_YAFFS2 = n
ENABLE_ROOTFS_ROMFS = y
ENABLE_ROOTFS_CRAMFS = y

ENABLE_DECOMPRESS_GZIP = y
ENABLE_DECOMPRESS_LZMA = y
ENABLE_DECOMPRESS_LZO = n
ENABLE_DECOMPRESS_ZLIB = y
ENABLE_COMPRESS_ZLIB = n

#############################################################
#
##III Module & function configurations
#
#############################################################
ENABLE_SPIFLASH = y
ENABLE_SPINAND = n
ENABLE_NANDFLASH = n
ENABLE_IRQ = y
ENABLE_UART_IRQ = n
ENABLE_USB = y
ENABLE_FAT_WRITE = y
# usb work mode : compatible/speed
USB_WORKMODE = compatible
ENABLE_GX_OTP= y
ENABLE_NET = y
ENABLE_I2C = n
ENABLE_GPIO= y
ENABLE_EEPROM = n
ENABLE_IRR = n
ENABLE_RTC = y
ENABLE_CTR = n
ENABLE_CHIP_INFO = y
ENABLE_WDT = y
ENABLE_TIME = y

# use io framework for read write ioct .. ops
ENABLE_IO_FRAMEWORK = n

# if you want to use flash write/erase, you must enable it
ENABLE_FLASH_FULLFUNCTION = y

# if you want to use otp write, you must enable it
ENABLE_OTP_FULLFUNCTION = y

# ENABLE SHOW LOGO. gx3201 only support show jpeg logo.
ENABLE_LOGO = n
# VOUT MODE ENABLE CONFIG
ENABLE_PAL = y
ENABLE_PAL_M = n
ENABLE_PAL_N = n
ENABLE_PAL_NC = n
ENABLE_NTSC_M = n
ENABLE_NTSC_443 = n
ENABLE_YPBPR_HDMI_480I = n
ENABLE_YPBPR_HDMI_480P = n
ENABLE_YPBPR_HDMI_576I = y
ENABLE_YPBPR_HDMI_576P = y
ENABLE_YPBPR_HDMI_720P_50HZ = y
ENABLE_YPBPR_HDMI_720P_60HZ = y
ENABLE_YPBPR_HDMI_1080I_50HZ = y
ENABLE_YPBPR_HDMI_1080I_60HZ = y
ENABLE_YPBPR_HDMI_1080P_50HZ = y
ENABLE_YPBPR_HDMI_1080P_60HZ = y

# ENABLE GDI. when one of LOGO/GDI is enabled, will enable vout too.
ENABLE_GDI = n
CONFIG_GDI_BPP = 16

# if you generate the bin for linux boot tool, please enable it
ENABLE_BOOT_TOOL = y

# generate gxloader with ota: set ENABLE_LIB n & ENABLE_OTA y
# generate OTA LIB: set ENABLE_LIB y & ENABLE_OTA n
ENABLE_LIB = n
ENABLE_OTA = n

# UART 0/1/2/3
CONFIG_UART_PORT = 0
CONFIG_UART_BAUDRATE = 115200

#################################################################
#
##IV other option
#
#################################################################
# GDB DEBUG CONFIG
ENABLE_GDB_DEBUG = n

# CREATE DENALI ELF
ENABLE_DENALI_ELF = n

# module test switch
ENABLE_FLASH_TEST = n

# MEMORY function for memory test
ENABLE_MEMORY = n

#SECURE BOOT VERIFY : RSA_PKCS | RSA_SMI
SECURE_VERIFY_TYPE =

# DATA ENCRYPT : aes128-cbc/aes128-ecb
DATA_ENCRYPT_TYPE =

# DATA ENCRYPT : 0x01(only stage1)/0x10(only stage2)/0x11(stage1 and stage2)/0x00(none encrypt)
DATA_ENCRYPT = 0x00

# if you want to use loader cmd fun, you must enable it
ENABLE_CMD = y

SECURE_FIRMWARE_LOAD = n

# DEMUX_ES(1 << 0), DEMUX_TSW(1 << 1), DEMUX_TSR(1 << 2), GP_ES(1 << 3), AUDIO_FIRMWARE(1 << 4), AUDIO_FRAME(1 << 5), VIDEO_FIRMWARE(1 << 6), VIDEO_FRAME(1 << 7), VPU_CAP(1 << 8), SCPU(1 << 9)
# if protect type is DEMUX_TSW/GP_ES, set MEMORY_PROTECT_TYPE= ((1 << 1) | (1 << 3))
MEMORY_PROTECT_TYPE =

ROM_SERIAL_BAUDRATE = 100000

ENABLE_SECURE_ALIGN = n
