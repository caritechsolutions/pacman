
choice
    prompt "Vendor Name"
    help
      Select Project Family

config BR2_FAMILY_MINI
  bool "MINI"
    depends on (BR2_CHIP_CANOPUS && BR2_OS_ECOS) || (BR2_CHIP_CYGNUS && BR2_OS_ECOS) || (BR2_CHIP_GX6605S && BR2_OS_ECOS) || (BR2_CHIP_SCORPIO && BR2_OS_ECOS) || (BR2_CHIP_SCORPIOTAURUS && BR2_OS_ECOS) || (BR2_CHIP_TAURUS && BR2_OS_ECOS) || (BR2_CHIP_VEGA && BR2_OS_ECOS) 

config BR2_FAMILY_PUBLIC
  bool "PUBLIC"
    depends on (BR2_CHIP_CANOPUS && BR2_OS_ECOS) || (BR2_CHIP_CANOPUS && BR2_OS_LINUX) || (BR2_CHIP_SCORPIO && BR2_OS_LINUX) || (BR2_CHIP_TAURUS && BR2_OS_ECOS) || (BR2_CHIP_VEGA && BR2_OS_ECOS) || (BR2_CHIP_VEGA && BR2_OS_LINUX) 


endchoice

config BR2_FAMILY_NAME
    string
    default "mini" if BR2_FAMILY_MINI
    default "public" if BR2_FAMILY_PUBLIC

if BR2_FAMILY_MINI

choice
