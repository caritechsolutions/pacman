menu "Module Configuration"

# Network devices and network applications configuration
source system/configin/Config.in.network
if (BR2_DEMOD1_DVB_T2 || BR2_DEMOD1_COMBO_T || BR2_DEMOD2_DVB_T2 || BR2_DEMOD2_COMBO_T || BR2_DEMOD3_DVB_T2 || BR2_DEMOD3_COMBO_T || BR2_DEMOD4_DVB_T2 || BR2_DEMOD4_COMBO_T)
source system/configin/Config.in.area
endif
# Output configuration
menu "Audio and Video configuration"

config BR2_MOD_APP_CVBS_SCALE
    bool "CVBS Scale Support"
    help

config BR2_MOD_APP_HDCP_MODE
    bool "HDCP Support"
    help

config BR2_MOD_APP_PP_FULL_HD_SUPPORT
	bool "Full HD PP Mode Support"
