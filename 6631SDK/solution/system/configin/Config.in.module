config BR2_MOD_APP_AUDIO_LANG_QAA2OST_SUPPORT
    bool "Audio lang qaa2ost Support"
    depends on (BR2_TUNER_TYPE != "ott")
    help
        Support original audio tracks, replace QAA with OST

config BR2_MOD_APP_HIGH_DYNAMIC_RANGE_CONFIG
    bool "High Dynamic Range Support"
    depends on ((BR2_CHIP_NAME = "cygnus") && ((BR2_BOARD_NAME = "6706S5") || (BR2_BOARD_NAME = "6706H5") || (BR2_BOARD_NAME = "6706H5-combo") || (BR2_BOARD_NAME = "Cygnus-X5")) || BR2_CHIP_NAME = "canopus" || BR2_CHIP_NAME = "vega") && (!BR2_MOD_APP_CVBS_TEST)

config BR2_MOD_APP_VIDEO_SHARPNESS
	bool "Video Sharpness Support"
    depends on !(BR2_CHIP_GX3211 || BR2_CHIP_GX6605S)
	help

config BR2_MOD_APP_VIDEO_HUE
	bool "Video Hue Support"
    depends on !(BR2_CHIP_GX3211 || BR2_CHIP_GX6605S)
	help

config BR2_MOD_APP_VIDEO_DEINTERLACE
	bool "Video Deinterlace Support"
	help


endmenu

