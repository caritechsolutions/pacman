# DVB search configuration
menu "Search configuration"

config BR2_MOD_APP_UNICABLE
	bool "Unicable Support"
	help

config BR2_MOD_APP_LNBF
	bool "Multi-Point LNBF Support"
	help

config BR2_MOD_NO_AVPROG_SAVE
	bool "No AV Program Save Support"
	help
        When searching, no audio or video programs are saved.

config BR2_MOD_RESERVED_SERVICE_NOSAVE
    bool "Not Save Reserved Service Program Support"
    help
        When int sdt table the service type is zero the channel not be saved.

config BR2_MOD_APP_SUPERBLIND
    bool "Super Blind Support"
    help

config BR2_MOD_APP_MULTISTREAM
    bool "Multi-Stream Support"
    help

config BR2_MOD_APP_PDMX
    bool "PDMX Support"
    help

config BR2_MOD_APP_SYS_SAVE_DIRECT
	bool "System Save Direct"
	help

config BR2_MOD_PSI_MODULE
    bool "PSI Module Support"
    help

config BR2_MOD_APP_BOUQUET
    bool "Bouquet Support"
    select BR2_MOD_PSI_MODULE
    help

config BR2_MOD_APP_BAT_NOTSID_GROUP
    bool "Bouquet Mismatch Tsid"
    depends on BR2_MOD_APP_BOUQUET
    help
        Only according to service_id grouping.

config BR2_MOD_SDT_SUPPORT
    bool "SDT Support"
    select BR2_MOD_PSI_MODULE
    help

config BR2_MOD_PAT_SUPPORT
    bool "PAT Support"
    select BR2_MOD_PSI_MODULE
    help

config BR2_MOD_PMT_UPDATE_SUPPORT
    bool "PMT Update Support"
    help
        Support updating pmt data when PMT table changes

config BR2_MOD_APP_BACK_UPDATE
    bool "Auto Update Support"
    select BR2_MOD_PSI_MODULE
	help

config BR2_MOD_APP_ALL_VERSION_SUPPORT
    bool "Full Version Upgrade Support"
    depends on BR2_MOD_APP_BACK_UPDATE
    help
        Support full version upgrade of SDT table and pat table, but it will increase memory and CPU load.

config BR2_MOD_APP_MISMATCH_TSID
    bool "Auto Update Mismatch Tsid"
    depends on BR2_MOD_APP_BACK_UPDATE
    help
        Support different transport stream id under the same TP Automatic update of ID stream program.

config BR2_MOD_APP_PROPMT_AUTO_UPDATE
    bool "Auto Update Propmt Support"
    depends on BR2_MOD_APP_BACK_UPDATE
    help
         When the program is playing, the background starts to update the program information, telling the user that the program is being updated.

config BR2_MOD_OTHER_AUTO_UPDATE
      bool  "Other_Ts_Update Support"
      depends on BR2_MOD_APP_BACK_UPDATE

config BR2_MOD_LCN_AUTO_UPDATE
      bool  "LCN Auto Update Support"
      select BR2_MOD_APP_LCN
      depends on BR2_MOD_APP_BACK_UPDATE

config BR2_MOD_SEARCH_AUTO_SAVE
	bool "Search Auto Save Support"

config BR2_MOD_SW_FILTER_SUPPORT
	bool "Soft Filter Support"
    depends on BR2_CHIP_GEMINI

config BR2_MOD_TUNER_AUTO_ADAPT
    bool "Tuner Auto Adapt"
    depends on BR2_CHIP_GEMINI || BR2_CHIP_CYGNUS
    help
        Tuner configuration adaptive

config BR2_MOD_DVBC_TUNE_AUTO
    bool "DVBC Tune Auto"
    depends on BR2_DEMOD1_DVB_C || BR2_DEMOD1_COMBO_C || BR2_DEMOD2_DVB_C || BR2_DEMOD2_COMBO_C || BR2_DEMOD3_DVB_C || BR2_DEMOD3_COMBO_C || BR2_DEMOD4_DVB_C || BR2_DEMOD4_COMBO_C
    help
        DVBC Auto QAM and SymbolRate support

config BR2_MOD_APP_LCN
    bool "LCN Support"
    help
        when search program, get logic channel num

config BR2_MOD_APP_SEARCH_SHOW_LCN
    bool "SEARCH_SHOW_LCN_SUPPORT"
    depends on BR2_MOD_APP_LCN
    help
        Display the logical channel number of the program during the search

config BR2_MOD_APP_LCN_VISIBLE_FLAG_SUPPORT
    bool "LCN Visible Flag Support"
    depends on BR2_MOD_APP_LCN
    help
        when into nit table the visible flag = 0 ,the channel must be saved but the custome can watch only DIGIT directly the LCN Number.

config BR2_MOD_APP_LCN_CONFLICT_HANDLE
    bool "Handle LCN Conflict Support"
    help
        when exist same channel logic num, handle lcn conflict
    depends on BR2_MOD_APP_LCN

choice

	prompt "LCN Conflict Rule"
	depends on BR2_MOD_APP_LCN_CONFLICT_HANDLE
	default BR2_MOD_APP_LCN_CONFLICT_HANDLE_BY_COMMON

	config BR2_MOD_APP_LCN_CONFLICT_HANDLE_BY_USER
	    bool "Handle LCN Conflict By User Select"
	    help
	    	Handling lcn conflict by user select

	config BR2_MOD_APP_LCN_CONFLICT_HANDLE_BY_VIRTUAL_LCN
	    bool "Handle LCN Conflict By Virtual LCN"
	    help
            Keep the first element in the lcn conflict list, and allocate virtual LCNs to others

    config BR2_MOD_APP_LCN_CONFLICT_HANDLE_BY_THROW_AWAY
        bool "Handle By Conflict By Throw Away"
        help
            The same program in the conflict list keeps the first one, and the others are deleted; non-same programs are allocated virtual LCN

endchoice

choice

    prompt "LCN Conflict Sorting Method"
    depends on BR2_MOD_APP_LCN_CONFLICT_HANDLE
    default BR2_MOD_APP_LCN_SORTED_BY_SEARCH_ORDER

    config BR2_MOD_APP_LCN_SORTED_BY_SEARCH_ORDER
        bool "LCN Sorted By Search Order"
        help
            The elements in the lcn conflict list are sorted in order of search

    config BR2_MOD_APP_LCN_SORTED_BY_RFCH_SQ_ORDER
        bool "LCN Sorted By RFCH SQ Order"
        help
            The elements in the lcn conflict list are sorted in order of RF strength and quality

    config BR2_MOD_APP_LCN_SORTED_BY_FRE_ORDER
        bool "LCN Sorted By Frequency Order"
        help
            The elements in the lcn conflict list are sorted by their tp frequency

    config BR2_MOD_APP_LCN_SORTED_BY_HD_CHANNEL
        bool "LCN Sorted By HD Channel"
        help
            The elements in the lcn conflict list are sorted by HD Channel
endchoice

config BR2_MOD_APP_LCN_VALID_CHECK
    bool "LCN Valid Check"
    depends on BR2_MOD_APP_LCN_CONFLICT_HANDLE
    help
        Whether to conduct LCN legal check

choice

    prompt "LCN Valid Check Rule"
    depends on BR2_MOD_APP_LCN_VALID_CHECK
    default BR2_MOD_APP_LCN_ONID_CHECK

    config BR2_MOD_APP_LCN_ONID_CHECK
        bool "Check By Original Id"
        help
            Check whether LCN is valid according to original id

    config BR2_MOD_APP_LCN_NID_CHECK
        bool "Check By Network id"
        help
            Check whether LCN is valid according to network id

endchoice

config BR2_MOD_PRESET_PROG_INFO_CORRECT
    bool "Preset Program Info Correction"
    help
        When the imagetool tool presets the program, some information will be wrong and need to be repaired
    select BR2_MOD_PSI_MODULE

config BR2_MOD_LNB_SHORT_DETECT
    bool "LNB Short Circuit Detection"
    help
        When board support gpio lnb short circuit detection, it can detect lnb short circuit, then power off lnb
    depends on (BR2_DEMOD1_DVB_S2 || BR2_DEMOD2_DVB_S2 || BR2_DEMOD3_DVB_S2 || BR2_DEMOD4_DVB_S2 || \
                BR2_DEMOD1_COMBO_S || BR2_DEMOD2_COMBO_S || BR2_DEMOD3_COMBO_S || BR2_DEMOD4_COMBO_S)

endmenu
endif

