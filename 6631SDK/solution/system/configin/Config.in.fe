comment "Tuner Config"
	
choice
	prompt "Tuner Number Configuration"
	default BR2_BOARD_TUNER_1TUNER

config BR2_BOARD_TUNER_1TUNER
	bool "Single Tuner"

config BR2_BOARD_TUNER_2TUNER
	bool "Twin Tuners"
	select BR2_MOD_APP_2TUNER

config BR2_BOARD_TUNER_3TUNER
	bool "Triple Tuners"

config BR2_BOARD_TUNER_4TUNER
	bool "Four Tuners"

endchoice


menu "Tuner 1 or Tuner A Configuration"

choice
	prompt "Tuner Config"
	default BR2_BOARD_TUNER1_TUNER_AV2011
	help

