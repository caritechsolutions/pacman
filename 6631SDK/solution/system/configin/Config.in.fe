if BR2_BOARD_TUNER_4TUNER

menu "Tuner 4 or Tuner D Configuration"

choice
	prompt "Tuner Config"
	default BR2_BOARD_TUNER4_TUNER_AV2011
	help

config BR2_BOARD_TUNER4_TUNER_AV2020
	bool "Tuner AV2020"

config BR2_BOARD_TUNER4_TUNER_AV2011
	bool "Tuner AV2011"
	
config BR2_BOARD_TUNER4_TUNER_CE5039
	bool "Tuner CE5039"
	
config BR2_BOARD_TUNER4_TUNER_SHARP1302
	bool "Tuner Sharp1302"

config BR2_BOARD_TUNER4_TUNER_SHARP7306
	bool "Tuner Sharp7306"

config BR2_BOARD_TUNER4_TUNER_MTV600
	bool "Tuner MTV600"

config BR2_BOARD_TUNER4_TUNER_MJ0914S
	bool "Tuner MJ0914S"
	
endchoice

config BR2_BOARD_TUNER4_TUNER_I2C_ADDR
	hex "Tuner I2C address"
	default 0xc6 if BR2_BOARD_TUNER4_TUNER_AV2011
	default 0xc0 if BR2_BOARD_TUNER4_TUNER_CE5039
	default 0x00
	
config BR2_BOARD_TUNER4_TUNER_I2C_MASTER
	int "Chip I2C master"
	default 0

choice 
	prompt "Demod Config"
	default BR2_BOARD_TUNER4_DEMOD_GX1132

config BR2_BOARD_TUNER4_DEMOD_GX1132
	bool "Demod GX1132"

config BR2_BOARD_TUNER4_DEMOD_GX1131
	bool "Demod GX1131"

config BR2_BOARD_TUNER4_DEMOD_GX1101
	bool "Demod GX1101"

config BR2_BOARD_TUNER4_DEMOD_GX1503
	bool "Demod GX1503"

config BR2_BOARD_TUNER4_DEMOD_GX1001
	bool "Demod GX1001"

config BR2_BOARD_TUNER4_DEMOD_GX1201
	bool "Demod GX1201"

endchoice

config BR2_BOARD_TUNER4_DEMOD_I2C_ADDR
	hex "Demod I2C Address"
	default 0xd0 if BR2_BOARD_TUNER4_DEMOD_GX1132
	default 0x00

config BR2_BOARD_TUNER4_DEMOD_I2C_MASTER
	int "Chip I2C master"
	default 0

menu	"DEMOD TS output Configuration"

choice 
	prompt "Demod TS Data Pins"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PARALLEL

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PARALLEL
	bool "Parallel: 8 Pins"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_SERIAL
	bool "Serial: 1 Pin"

endchoice

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_LINES
	string
	default "PARALLEL" if BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PARALLEL
	default "SERIAL" if BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_SERIAL


choice
	prompt "Demod TS Data Order"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_NORMAL

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_NORMAL
	bool "Datas[0..7]"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_SWAP
	bool "Datas[7..0]"

endchoice

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_ORDER
	string
	default "NORMAL" if BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_NORMAL
	default "SWAP"  if BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_SWAP


choice
	prompt "Demod TS Control Pins[1]"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN1

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN1
	bool "TS_DATA"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN1
	bool "TS_SYNC"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN1
	bool "TS_VALID"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN1
	bool "TS_CLK"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_ERROR_PIN1
	bool "TS_ERROR"

endchoice

choice
	prompt "Demod TS Control Pins[2]"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN2

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN2
	bool "TS_DATA"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN2
	bool "TS_SYNC"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN2
	bool "TS_VALID"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN2
	bool "TS_CLK"


config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_ERROR_PIN2
	bool "TS_ERROR"

endchoice

choice
	prompt "Demod TS Control Pins[3]"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN3

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN3
	bool "TS_DATA"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN3
	bool "TS_SYNC"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN3
	bool "TS_VALID"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN3
	bool "TS_CLK"

endchoice

choice
	prompt "Demod TS Control Pins[4]"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN4

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN4
	bool "TS_DATA"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN4
	bool "TS_SYNC"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN4
	bool "TS_VALID"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN4
	bool "TS_CLK"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_ERROR_PIN4
	bool "TS_ERROR"

endchoice


choice
	prompt "Demod TS Control Pins[5]"
	default BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN5

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_DATA_PIN5
	bool "TS_DATA"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_SYNC_PIN5
	bool "TS_SYNC"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_VALID_PIN5
	bool "TS_VALID"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_CLK_PIN5
	bool "TS_CLK"

config BR2_BOARD_TUNER4_DEMOD_TS_OUTPUT_ERROR_PIN5
	bool "TS_ERROR"

endchoice

endmenu

config BR2_BOARD_TUNER4_IQ_SWAP
	int "I/Q Swap"
	default 0

config BR2_BOARD_TUNER4_HV_SWAP
	int "H/V Swap"
	default 0


choice 
	prompt "LNB Power Control"
	default BR2_BOARD_TUNER4_LNB_POWER_CONTROL_GPIO

config BR2_BOARD_TUNER4_LNB_POWER_CONTROL_GPIO
	bool "GPIO"

config BR2_BOARD_TUNER4_LNB_POWER_CONTROL_SY7208
	bool "SY7208"

config BR2_BOARD_TUNER4_LNB_POWER_CONTROL_A8293
	bool "A8293"

endchoice

config BR2_BOARD_TUNER4_LNB_POWER_CONTROL
	string 
 	default "GPIO" if BR2_BOARD_TUNER4_LNB_POWER_CONTROL_GPIO
 	default "SY7208" if BR2_BOARD_TUNER4_LNB_POWER_CONTROL_SY7208
 	default "A8293" if BR2_BOARD_TUNER4_LNB_POWER_CONTROL_A8293

endmenu

endif # BR2_BOARD_TUNER_4TUNER

