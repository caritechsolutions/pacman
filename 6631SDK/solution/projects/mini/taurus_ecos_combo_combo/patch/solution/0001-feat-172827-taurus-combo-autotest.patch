diff --git a/app/module/autotest/common/common_commands.c b/app/module/autotest/common/common_commands.c
index 2e043ada..1bee846e 100644
--- a/app/module/autotest/common/common_commands.c
+++ b/app/module/autotest/common/common_commands.c
@@ -36,6 +36,8 @@ enum
 
 static dev_tbl_t *dev_ops = NULL;
 
+extern void app_s2_t2_pin_switch(int tuner);
+
 static signed int do_set_mode(cmd_tbl_t *cmdtp, int flag, int argc, char *argv[], char *orgcmd)
 {
     char dev_name[10] = {0};
@@ -70,6 +72,14 @@ static signed int do_set_mode(cmd_tbl_t *cmdtp, int flag, int argc, char *argv[]
 		result_code = PARAMETER_IS_INVALID;
 		goto err;
 	}
+
+    if(0 == strcmp(dev_name, "dvbs"))
+        app_s2_t2_pin_switch(0);
+    else if(0 == strcmp(dev_name, "dvbt2"))
+        app_s2_t2_pin_switch(1);
+    else if(0 == strcmp(dev_name, "dvbc"))
+        app_s2_t2_pin_switch(1);
+
 	pResult = "successful";
 	auto_test_reply(cmdtp->name, pResult, result_code, NULL);
 	// TODO: reply lock status
diff --git a/app/module/autotest/module/module_frontend.c b/app/module/autotest/module/module_frontend.c
