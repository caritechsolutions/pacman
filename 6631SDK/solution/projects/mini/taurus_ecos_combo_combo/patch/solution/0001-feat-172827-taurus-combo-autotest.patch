 }
 
+extern int32_t app_gpio_polar_set(uint32_t hv);
 //
 int frontend_voltage(int *pFrontendFd, unsigned int voltage)
 {
@@ -96,6 +97,13 @@ int frontend_voltage(int *pFrontendFd, unsigned int voltage)
 		log_printf("\nTEST, error, %s, %d\n",__FUNCTION__,__LINE__);
 		return -1;
 	}
+
+    if(SEC_VOLTAGE_13 == voltage)
+        app_gpio_polar_set(0);
+    else if(SEC_VOLTAGE_18 == voltage)
+        app_gpio_polar_set(1);
+    else if(SEC_VOLTAGE_OFF == voltage)
+
 	ret = ioctl (*pFrontendFd, FE_SET_VOLTAGE, voltage);
 	if(ret < 0)
