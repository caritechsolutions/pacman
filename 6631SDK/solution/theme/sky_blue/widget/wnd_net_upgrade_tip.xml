<?xml version="1.0" encoding="UTF-8"?>
<widget class="window" style="default" name="wnd_net_upgrade_tip">
    <property>
        <rect>[300,200,424,230]</rect>
        <forecolor>[gui_trans,gui_trans,gui_trans]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
        <format>popup</format>
    </property>
    <signal>
        <create>app_net_upgrade_tip_create</create>
        <destroy>app_net_upgrade_tip_destroy</destroy>
        <service>app_net_upgrade_tip_service</service>
        <keypress>app_net_upgrade_tip_keypress</keypress>
    </signal>
    <children>
        <widget class="image" style="default" name="img_net_upgrade_tip_bg">
            <property>
                <rect>[0,0,424,230]</rect>
                <forecolor>[osd_trans,osd_trans,osd_trans]</forecolor>
                <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
                <mode>multiple</mode>
                <img></img>
                <lt_img>s_win_l_t</lt_img>
                <rt_img>s_win_r_t</rt_img>
                <lb_img>s_win_l_b</lb_img>
                <rb_img>s_win_r_b</rb_img>
                <l_img>s_win_l_m</l_img>
                <r_img>s_win_r_m</r_img>
                <t_img>s_win_m_t</t_img>
                <b_img>s_win_m_b</b_img>
            </property>
        </widget>
        <widget class="text" style="default" name="text_net_upgrade_tip_title">
            <property>
                <rect>[12,1,400,28]</rect>
                <state>show</state>
                <forecolor>[#f4f4f4,#f4f4f4,#f4f4f4]</forecolor>
                <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
                <string>Tips</string>
                <format>static</format>
            </property>
        </widget>
        <widget class="notepad" style="default" name="notepad_net_upgrade_tip">
            <property>
                <rect>[15,35,370,115]</rect>
                <forecolor>[text_color,text_color,text_color]</forecolor>
                <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
                <alignment>left|top</alignment>
                <vertical_margin>0</vertical_margin>
                <horizontal_margin>20</horizontal_margin>
            </property>
            <children>
                <widget class="scrollbar" style="default" name="scrollbar_net_upgrade_tip">
                    <property>
                        <rect>[361,0,9,115]</rect>
                        <forecolor>[default_color,default_color,default_color]</forecolor>
                        <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
                        <back_img>s_roll_m</back_img>
                        <arrow_up>s_roll_t</arrow_up>
                        <arrow_down>s_roll_d</arrow_down>
                        <fore_img>s_roll_button</fore_img>
                        <format>scroll_show</format>
                    </property>
                </widget>
            </children>
        </widget>
        <widget class="text" style="default" name="text_net_upgrade_tip_time">
            <property>
                <rect>[165,160,185,25]</rect>
                <forecolor>[#f4f4f4,#f4f4f4,#f4f4f4]</forecolor>
                <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
                <alignment>right|vcentre</alignment>
                <string></string>
                <format>static</format>
            </property>
        </widget>
        <widget class="image" style="default" name="img_net_upgrade_tip_opt">
            <property>
                <rect>[29,195,366,30]</rect>
                <forecolor>[osd_trans,osd_trans,osd_trans]</forecolor>
                <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
                <mode>single</mode>
                <img>s_bar_choice_blue4</img>
            </property>
        </widget>
        <widget class="button" style="default" name="btn_net_upgrade_tip_ok">
            <property>
                <rect>[253,195,80,30]</rect>
                <forecolor>[#f4f4f4,#f4f4f4,osd_trans]</forecolor>
                <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
                <alignment>hcentre|vcentre</alignment>
                <string>OK</string>
            </property>
        </widget>
        <widget class="button" style="default" name="btn_net_upgrade_tip_cancel">
            <property>
                <rect>[80,195,80,30]</rect>
                <forecolor>[#f4f4f4,#f4f4f4,osd_trans]</forecolor>
                <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
                <alignment>hcentre|vcentre</alignment>
                <string>Cancel</string>
            </property>
        </widget>
    </children>
</widget>
