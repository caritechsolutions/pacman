<?xml version="1.0" encoding="UTF-8"?>
<widget class="window" style="default" name="wnd_volume_value">
    <property>
        <rect>[200,430,624,50]</rect>
        <mirror>disable</mirror>
        <forecolor>[osd_trans,osd_trans,osd_trans]</forecolor>
        <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
        <format>popup</format>
    </property>
    <signal>
        <create>app_volume_value_create</create>
        <destroy>app_volume_value_destroy</destroy>
        <keypress>app_volume_value_keypress</keypress>
        <service>app_volume_value_service</service>
    </signal>
    <children>
        <widget class="progbar" style="default" name="progbar_volume">
            <property>
                <rect>[45,20,520,10]</rect>
                <forecolor>[black,black,black]</forecolor>
                <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
                <min>0</min>
                <max>25</max>
                <back_image_l>s_progress_l</back_image_l>
                <back_image_m>s_progress_m</back_image_m>
                <back_image_r>s_progress_r</back_image_r>
                <fore_image_l>s_progress3_l</fore_image_l>
                <fore_image_m>s_progress3_m</fore_image_m>
                <fore_image_r>s_progress3_r</fore_image_r>
                <format>water</format>
                <text_format>hide</text_format>
                <alignment>hcentre|vcentre</alignment>
            </property>
        </widget>
        <widget class="text" style="default" name="txt_volume">
            <property>
                <rect>[575,9,40,32]</rect>
                <forecolor>[text_color,text_color,text_color]</forecolor>
                <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
                <string></string>
                <format>static</format>
            </property>
        </widget>
        <widget class="image" style="default" name="img_volume">
            <property>
                <rect>[10,13,25,24]</rect>
                <forecolor>[black,black,black]</forecolor>
                <backcolor>[window_bg_color,window_bg_color,window_bg_color]</backcolor>
                <mode>single</mode>
                <img>s_vol</img>
            </property>
        </widget>
    </children>
</widget>
