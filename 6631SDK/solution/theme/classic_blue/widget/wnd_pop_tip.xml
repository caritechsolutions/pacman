<?xml version="1.0" encoding="GB2312" standalone="no"?>
<widget class="window" style="default" name="wnd_pop_tip">
  <property>
    <rect>[400,190,480,240]</rect>
    <forecolor>[osd_trans,osd_trans,osd_trans]</forecolor>
    <backcolor>[osd_trans,osd_trans,osd_trans]</backcolor>
	<format>popup</format>
  </property>
  <signal>
    <create>app_popdlg_create</create>
    <destroy>app_popdlg_destroy</destroy>
     <service>app_popdlg_set_service</service>
    <keypress>app_popdlg_keypress</keypress>
  </signal>
  <children>
    <widget class="image" style="default" name="img_search_tip_bg">
      <property>
        <rect>[0,0,480,240]</rect>
        <forecolor>[default_color,default_color,default_color]</forecolor>
        <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
        <mode>multiple</mode>
        <img></img>
        <lt_img>s_win_l_t</lt_img>
        <rt_img>s_win_r_t</rt_img>
        <lb_img>s_win_l_b</lb_img>
        <rb_img>s_win_r_b</rb_img>
        <l_img>s_win_l_m</l_img>
        <r_img>s_win_r_m</r_img>
        <t_img>s_win_m_t</t_img>
        <b_img>s_win_m_b</b_img>
      </property>
    </widget>
    <widget class="text" style="default" name="txt_pop_tip_title">
      <property>
        <rect>[15,2,450,35]</rect>
        <forecolor>[pop_title_color,pop_title_color,pop_title_color]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
        <string>Tips</string>
        <format>static</format>
      </property>
    </widget>
    <widget class="text" style="default" name="txt_pop_tip">
      <property>
        <rect>[20,50,440,130]</rect>
        <forecolor>[pop_text_color,pop_text_color,text_color]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
        <alignment>left|top</alignment>
        <string></string>
        <format>automatic</format>
      </property>
    </widget>
    <widget class="image" style="default" name="img_pop_tip_opt">
      <property>
        <rect>[11,185,458,38]</rect>
	<mirror>disable</mirror>
        <forecolor>[default_color,default_color,default_color]</forecolor>
        <backcolor>[default_color,default_color,default_color]</backcolor>
        <mode>single</mode>
        <img>s_bar_choice_blue4</img>
      </property>
    </widget>
    <widget class="button" style="default" name="btn_pop_tip_ok">
      <property>
        <rect>[310,185,100,38]</rect>
	<mirror>disable</mirror>
        <forecolor>[text_color,text_focus_color,text_color]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
        <alignment>hcentre|vcentre</alignment>
        <string>OK</string>
      </property>
    </widget>
    <widget class="button" style="default" name="btn_pop_tip_cancel">
      <property>
        <rect>[70,185,100,38]</rect>
	<mirror>disable</mirror>
        <forecolor>[text_color,text_focus_color,text_color]</forecolor>
        <backcolor>[gui_trans,gui_trans,gui_trans]</backcolor>
        <alignment>hcentre|vcentre</alignment>
        <string>Cancel</string>
      </property>
    </widget>
    <widget class="text" style="default" name="txt_pop_time">
      <property>
        <rect>[260,140,150,32]</rect>
        <forecolor>[pop_text_color,pop_text_color,text_color]</forecolor>
        <backcolor>[pop_bg_color,pop_bg_color,pop_bg_color]</backcolor>
        <alignment>right|vcentre</alignment>
        <string></string>
        <format>static</format>
      </property>
    </widget>
  </children>
</widget>
