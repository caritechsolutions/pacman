	<style class="prompt" name="usb_inout_prompt">
		<property>
			<rect>[0,0,30,41]</rect>
            <backcolor>[#ff00ff,#ff00ff,#ff00ff]</backcolor>
		</property>
		<children>
			<widget class="image" style="default" name="usb_inout_image">
				<property>
					<rect>[0,0,30,41]</rect>
                    <forecolor>[#00FF00,#00FF00,#00FF00]</forecolor>
                    <backcolor>[#ff00ff,#ff00ff,#ff00ff]</backcolor>
					<mode>single</mode>
					<img></img>
				</property>
			</widget>
		</children>
	</style>

	<style class="prompt" name="face_detect_prompt">
		<property>
			<rect>[0,0,80,80]</rect>
            <backcolor>[#ff00ff,#ff00ff,#ff00ff]</backcolor>
		</property>
		<children>
			<widget class="image" style="default" name="face_detect_image">
				<property>
					<rect>[0,0,80,80]</rect>
                    <forecolor>[#00FF00,#00FF00,#00FF00]</forecolor>
                    <backcolor>[#ff00ff,#ff00ff,#ff00ff]</backcolor>
					<mode>single</mode>
					<img>s_icon_face_detect</img>
				</property>
			</widget>
		</children>
	</style>

	<style class="prompt" name="vc_notify_prompt">
		<property>
            <rect>[30,0,1200,88]</rect>
			<backcolor>[#080808,#080808,#080808]</backcolor>
		</property>
		<children>
			<widget class="image" style="default" name="img_vc_notify_icon">
				<property>
					<rect>[18,14,52,48]</rect>
					<forecolor>[#000000,#000000,#000000]</forecolor>
					<backcolor>[#31314a,#31314a,#31314a]</backcolor>
					<mode>single</mode>
					<img>notify</img>
				</property>
			</widget>
			
			<widget class="text" style="default" name="txt_vc_notify_content">
				<property>
					<rect>[100,12,1100,64]</rect>
					<forecolor>[#f4f4f4,#f4f4f4,#f4f4f4]</forecolor>
					<backcolor>[#ff00ff,#ff00ff,#ff00ff]</backcolor>
					<alignment>left|vcentre</alignment>
					<string></string>
					<format>automatic</format>
				</property>
			</widget>
		
		</children>
	</style>
</interface>
