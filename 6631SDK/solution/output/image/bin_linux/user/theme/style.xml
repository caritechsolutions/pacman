	<style class="listview" name="default_listview">
		<property>
			<rect>[44,140,212,450]</rect>								
			<backcolor>[#67A958,#503A8F,#85347A]</backcolor>								
			<forecolor>[#1F1F4D,#FDFDFD,#1F1F4D]</forecolor>
			<unfocus_img>mp_buttongrey1</unfocus_img>	
			<focus_img>mp_buttonorange1</focus_img>		
			<disable_img>mp_buttongrey1</disable_img>
			<item_rect>[0,0,212,45]</item_rect>
			<item_bak_color>[#67A958,#503A8F,#85347A]</item_bak_color>
			<item_fore_color>[#1F1F4D,#000011,#1F1F4D]</item_fore_color>
