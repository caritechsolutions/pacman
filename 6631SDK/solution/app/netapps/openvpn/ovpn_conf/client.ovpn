client

dev tun
proto tcp
remote 192.168.1.80

resolv-retry infinite

tls-version-min 1.0

nobind
persist-key
persist-tun

cipher AES-128-CBC
data-ciphers AES-128-CBC:AES-256-CBC

#ca /dvb/theme/openvpn/ca.crt
#cert /dvb/theme/openvpn/client.crt
#key /dvb/theme/openvpn/client.key
#;tls-auth /dvb/theme/openvpn/ta.key 1
#auth-user-pass /home/gx/openvpn/login.conf

ca ca.crt
cert client.crt
key client.key
;tls-auth ta.key 1
auth-user-pass login.conf

#comp-lzo
verb 3
